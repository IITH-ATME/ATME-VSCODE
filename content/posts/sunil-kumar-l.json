  "content": "<div style=\"border: 2px solid black; padding: 10px; box-sizing: border-box;\">\n<div style=\"border: 2px solid black; padding: 10px; font-family: Arial, sans-serif; font-size: 16px;\">\n\n<!-- Heading -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold;\">Technical Staff Profile</div>\n<!-- Faculty Profile: Two Columns -->\n<table style=\"width: 100%; border: 2px solid black; border-collapse: collapse; margin-top: 10px;\">\n<tbody>\n<tr><!-- Photo Placeholder -->\n<td style=\"border: 2px solid black; width: 30%; text-align: center; padding: 10px;\"><img class=\"aligncenter size-full wp-image-9271\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/12/EEE-03.jpg\" alt=\"\" width=\"151\" height=\"200\"></td>\n<!-- Details -->\n<td style=\"border: 2px solid black; width: 70%; padding: 10px;\">\n<p style=\"text-align: left;\"><strong>Faculty Name: SUNIL KUMAR L</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Instructor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Electrical and Electronics Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience:</strong></p>\n<p style=\"text-align: left;\"><strong>Date of Joining Institution:&nbsp;</strong>01/03/2017</p>\n\n<table style=\"width: 100%;\">\n<tbody>\n<tr>\n<td width=\"253\"><strong>Academic: 13 Years</strong></td>\n<td width=\"257\"><strong>Industry: NA</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n<!-- Contact Details -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold; margin-top: 20px;\">Contact Details</div>\n<table style=\"border-collapse: collapse;\" width=\"100%\">\n<tbody>\n<tr>\n<td width=\"18%\"><strong>Email ID</strong></td>\n<td width=\"44%\"><strong>Official:</strong></td>\n<td width=\"37%\"><strong>Personal: </strong></td>\n</tr>\n<tr>\n<td width=\"18%\">&nbsp;</td>\n<td width=\"44%\"><a href=\"mailto:SunilKumarL_ee@old.atme.edu.in\"><strong>SunilKumarL_ee@old.atme.edu.in</strong></a></td>\n<td width=\"37%\"><a href=\"mailto:Girishl.2105@gmail.com\"><strong>Girishl.2105@gmail.com</strong></a></td>\n</tr>\n</tbody>\n</table>\n<!-- Academic Details -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold; margin-top: 20px;\">Academic Details</div>\n<p style=\"text-align: left;\"><strong>Qualification</strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\">Diploma in EEE</li>\n</ul>\n<!-- Certifications -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold;\">Workshops/STTP/MOOC Certification</div>\n<div style=\"padding: 15px;\">\n\n<strong>Online Course:</strong>\n<ul>\n \t<li>Udemy: Electrical Course I, Electrical Course II</li>\n \t<li>Tata Steel: Power system earthing, Induction Motor</li>\n \t<li>Two Day online workshop in CIT College Gubbe</li>\n \t<li>FDP: SJB Institute Four day workshop on A Skill Enhancement Workshop for Technical Staff</li>\n</ul>\n</div>\n<!-- Roles and Responsibilities: Institute Level -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold;\">Roles and Responsibilities: Institute Level</div>\n<div style=\"padding: 15px;\">DG Maintenance, Electrical Maintenance, Admission work, Scholarship work</div>\n<!-- Roles and Responsibilities: Department Level -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold;\">Roles and Responsibilities: Department Level</div>\n<div style=\"padding: 15px;\">Instructor for Basic Electrical Lab, Electrical Machines Lab –I, Electrical Machines Lab II, Control System Lab, Microcontroller lab, DSP Lab, Electronics Lab</div>\n</div>\n</div>",
