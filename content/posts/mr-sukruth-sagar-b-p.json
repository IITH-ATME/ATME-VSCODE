  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-27684 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/03/SUKRUTH-SAGAR-B-P-1.jpg.jpeg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: <span style=\"text-decoration: underline; color: #333399;\">SUKRUTH SAGAR B P</span></strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Mechanical Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: </strong></p>\n\n<table class=\"alignleft\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td style=\"width: 158px;\"><strong>Teaching: </strong>08</td>\n<td style=\"width: 184px;\"><strong>Research: </strong>03</td>\n<td style=\"width: 168px;\"><strong>Industry:</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td style=\"width: 147px; height: 1px;\">\n<p style=\"text-align: left;\"><strong>Email ID</strong></p>\n</td>\n<td style=\"width: 286px; height: 1px; text-align: left;\"><strong>Official: <a href=\"mailto:sukruthsagarbp.me@old.atme.edu.in\">sukruthsagarbp.me@old.atme.edu.in</a></strong></td>\n<td style=\"width: 286px; height: 1px; text-align: left;\"><strong>Personal: <a href=\"mailto:sukruthsagar1991@gmail.com\">sukruthsagar1991@gmail.com</a></strong></td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Vidwan ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 23px;\"><strong>Google Scholar ID</strong></td>\n<td style=\"width: 572px; height: 23px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Scopus ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Orcid ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Web of Science Researcher ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px; text-align: left;\"><strong>LinkedIn ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">\n<p style=\"text-align: left;\"><a href=\"http://www.linkedin.com/in/sukruth-sagar-b-p-499b741b7\">www.linkedin.com/in/sukruth-sagar-b-p-499b741b7</a></p>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration-line: underline; color: #333399;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></strong></span></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>Ph.D (Pursuing) </strong>in Wire EDM.</li>\n \t<li style=\"text-align: left;\"><strong>M.Tech</strong> in Machine Design.</li>\n \t<li style=\"text-align: left;\"><strong>B.E</strong> in Mechanical Engineering</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 2; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Areas of Interest</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 3; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"margin-left: 12pt; text-align: left;\">Metal Matrix Composites, Wire EDM.</p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 4; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\"><strong><span style=\"font-size: 18px;\">Publications Details</span></strong></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 5; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Dr Vikram C K, Syed Imran Ali, S. Raghavendra, Sukruth Sagar B. P, Akshay R N “Effect of transverse velocity on two square cylinders with corner modifications”, International Journal of Research and Analytical Reviews (IJRAR), Volume 8, Issue 2, ISSN: 2348-1269, June 2021</li>\n \t<li style=\"text-align: justify;\">Doddaswamy. V, Jayanth.M, Sukruth Sagar B P, “Experimental Investigation of Mechanical and Tribological Behavior of Al6061-TiO2 Processed by Stir Casting Technique”, UGC Care Journal, ISSN: 2394-3114, Vol-40, Issue-76, pp. 700-705, March 2020</li>\n \t<li style=\"text-align: justify;\">Dr. Ghanaraja S, Sukruth Sagar B P, Kiranakumara K M, Madhu G,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; “Fabrication and Study of Mechanical Properties of Al 6061-B4C Metal Matrix Composites”,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; UGC Care Journal, ISSN: 2394-3114, Vol-40, Issue-71, pp. 737-742, March 2020</li>\n \t<li style=\"text-align: justify;\">Sukruth Sagar B P, Ravikumar T R, Doddaswamy V, Akshay R N,&nbsp;&nbsp;&nbsp;&nbsp; “Modelling and static analysis of Small scale wind turbine blades”, International Journal of Scientific Research and Review, ISSN: 2279-543X, Volume 7, Issue 9, 408-415, Aug 2018</li>\n</ol>\n<div style=\"clear: both;\">&nbsp;</div></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 4; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">FDPs/Conferences/Workshops/STTP/MOOC Certification/Online Courses</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 5; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: justify;\">FDP on Universal Human Values Introductory FDP, 3 Days, VVCE, Mysore (Collaboration with AICTE). 07/09/2023 to 09/09/2023</li>\n \t<li style=\"text-align: justify;\">FDP on Diagnostic maintenance of mechanical systems, 5 Days, PES COLLEGE OF ENGINEERING in association with AICTE. 8/11/2021 to 12/11/2021</li>\n \t<li style=\"text-align: justify;\">FDP on Applications of Thermodynamics, 5 Days,&nbsp;&nbsp; PESITM, Shivamogga. 13th - 17th July, 2020</li>\n \t<li style=\"text-align: justify;\">International Conference on Advances in Mechanical Engineering Sciences (ICAMES-2k20) 28<sup>th</sup>, PESCE, Mandya,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Paper-1. Feb 2020</li>\n \t<li style=\"text-align: justify;\">International Conference on Advances in Mechanical Engineering Sciences (ICAMES-2k20) 28<sup>th</sup>, PESCE, Mandya,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Paper-2. Feb 2020</li>\n \t<li style=\"text-align: justify;\">FDP on Synthesis, Characterization and application of advanced materials. One week, Dept. of Mechanical Engg. PESCE, Mandya. 27th to 31st January 2020</li>\n \t<li style=\"text-align: justify;\">Workshop on Modern Equipments in Mechanical Engineering, One week,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; PESCE, Mandya. 13th - 18th Jan 2020</li>\n \t<li style=\"text-align: justify;\">Processing and application of composite materials, One week, FENFE and PESCE, 30th Sep - 5th Oct 2019</li>\n \t<li style=\"text-align: justify;\">FDP on Product design engineering using Fusion 360 “AUTODESK FUSION 360”, 5 Days, By ICT Academy at PESCE, Mandya. 28th JAN – 1st FEB 2019</li>\n \t<li style=\"text-align: justify;\">International Conference on Topical transcends in science, technology and management, SVIT, Bengaluru. 17th Aug 2018</li>\n \t<li style=\"text-align: justify;\">FDP on Revamping academicians to intensify the knowledge, One week, PES College of Engineering, Mandya. 26-06-2018 to 30-06-2018</li>\n \t<li style=\"text-align: justify;\">Workshop on COMPUTER AIDED ENGINEERING DRAWING,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; One week, PESCE, Mandya. 6TH-10TH Jan 2018</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">Roles and Responsibilities: </span></strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB; mso-bidi-font-weight: bold;\">Institute Level</span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: justify;\">Internal Assessment Coordinator for the year 2024-Till date</li>\n \t<li style=\"text-align: justify;\">ERP Co-Coordinator of Mechanical Department 2024-Till date</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n&nbsp;",
