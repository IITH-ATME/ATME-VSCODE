  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-27384 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/02/KALATHMA-M-K-1.jpg.jpeg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: KALATHMA M K</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: ASSISTANT PROFESSOR</strong></p>\n<p style=\"text-align: left;\"><strong>Program: COMPUTER SCIENCE &amp; ENGINEERING</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 21 YEARS &nbsp;6 MONTHS</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: center;\" width=\"158\"><strong>Teaching: 21 YEARS 6 MONTHS</strong></td>\n<td style=\"text-align: center;\" width=\"184\"><strong>Research: 5 years</strong></td>\n<td style=\"text-align: center;\" width=\"168\"><strong>Industry:&nbsp;</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\"><strong>Official: <a href=\"mailto:kalathmamk_cs@old.atme.edu.in\">kalathmamk_cs@old.atme.edu.in</a></strong></td>\n<td style=\"text-align: left;\"><strong>Personal: <a href=\"mailto:kalathma9@gmail.com\">kalathma9@gmail.com</a></strong></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Vidwan ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://vidwan.inflibnet.ac.in/profile/234472\">https://vidwan.inflibnet.ac.in/profile/234472</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Google Scholar ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://scholar.google.com/citations?user=7u4dkwoAAAAJ&amp;hl=en\">https://scholar.google.com/citations?user=7u4dkwoAAAAJ&amp;hl=en</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Scopus ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Orcid ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://orcid.org/0000-0002-8960-3304\">https://orcid.org/0000-0002-8960-3304</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Web of Science</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>LinkedIn ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://www.linkedin.com/public-profile/settings?lipi=urn%3Ali%3Apage%3Ad_flagship3_profile_self_edit_contact-info%3B%2FEVgoyClQc6JNPsYshy%2BVw%3D%3D\"><span style=\"color: #333333;\"><span style=\"color: #333333;\">https://www.linkedin.com/in/kalathma-m-k-b3362115/</span></span></a></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\">Pursuing <strong>Ph.D</strong> in the field of Image Processing</li>\n \t<li style=\"text-align: left;\"><strong>M.Tech</strong> in VLSI design &amp; Embedded System</li>\n \t<li style=\"text-align: left;\"><strong>B.E</strong> in Electronics &amp; Communication Engineering</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">Image Processing</li>\n \t<li style=\"text-align: left;\">IoT</li>\n \t<li style=\"text-align: left;\">Artificial Intelligence</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Published paper entitled “ <strong>An Effective Home Security system based on Multimodal Interaction</strong>” in Volume – 4, Issue – 8 of International Journal of Science and Technology(The IJST) on August 2016.</li>\n \t<li style=\"text-align: justify;\">Published paper entitled “ <strong>Pneumonia and Covid Detection using Ct scan through Auto Encoders</strong>” in Volume – 22, Issue – 1 of TELEMATIQUE on February 2023.</li>\n \t<li style=\"text-align: justify;\">&nbsp;</li>\n \t<li style=\"text-align: justify;\">Published paper entitled “ <strong>IoT-Enabled Military Operations: Progress in Real Time Decision Making</strong>” in Volume – 14, Issue – 5 of International Journal of Innovative Research ( <strong>IJIRSET</strong>) on August 2016.</li>\n \t<li style=\"text-align: justify;\">Published paper entitled “ <strong>Real Time Smart Energy meter with Automatic bill generation using IoT </strong>” in Volume – 12, Issue – 5 of International Journal of Creative Research Thoughts( <strong>IJCRT</strong>) on May 2024.</li>\n \t<li style=\"text-align: justify;\">Published paper entitled “ <strong>Home Automation and Security System </strong>” in Volume – 12, Issue – 5 of International Journal of Creative Research Thoughts( <strong>IJCRT</strong>) on May 2024.</li>\n \t<li style=\"text-align: justify;\">Published paper entitled “<strong>AI Based License Plate Detection</strong>” in Volume – 13, Issue – 2 of International Journal of Creative Research Thoughts( <strong>IJCRT</strong>) on Feb 2025.</li>\n \t<li style=\"text-align: justify;\">Published paper entitled “<strong>AI-Based Automatic Text Recognition And Text-To-Sound Conversion</strong>” in Volume – 13, Issue – 1 of International Journal of Creative Research Thoughts( <strong>IJCRT</strong>) on Jan 2025.</li>\n \t<li style=\"text-align: justify;\">Published paper entitled “ORGANIC FOOD TRACEBILITY SYSTEM INTEGRATING\nBLOCKCHAIN SIMULATION AND GENERATIVE AI FOR DOCUMENT VERIFICATION” in\nVolume – 13, Issue – 1 of International Journal of Creative Research Thoughts( IJCRT) on Jan 2026.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\"><strong>MEMBERSHIP IN PROFESSIONAL BODIES</strong></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">International Association of Engineers ( IA ENG )</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">HONOURS/AWARDS/ ACHIEVEMENTS</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\"><strong>FDPs/ Workshops</strong>\n<ol>\n \t<li style=\"text-align: justify;\">Kalathma M K, “5 Days Online Faculty Development Program on “An Overview of Teaching Techniques in Data Science and Analytics ” Organized by VTU Human Resource Development Centre ( VTU – HRDC ), Centre for PG Studies, VIAT, Muddenahalli, Chikkaballapur from 25th to 29st April 2022.</li>\n \t<li style=\"text-align: justify;\">Kalathma M K, “10 Days Online Faculty Development Program on “Computational Statistics ” Organized by E &amp; ICT Academy, NIT Warangal and JSS Science and Technology University, Mysuru from 1st to 10th August 2022.</li>\n \t<li style=\"text-align: justify;\">Kalathma M K, “5 Days Faculty Development Program on “5G/6G Technologies for wireless systems” at ATMECE, Mysuru from 27th to 31st March 2023.</li>\n \t<li style=\"text-align: justify;\">&nbsp;Kalathma M K, “4 weeks online lab workshop on “Embedded RTOS” at National Institute of Electronics and Information Technology (NIELIT), Calicut from 13th February to 10st March 2023.</li>\n \t<li style=\"text-align: justify;\">Kalathma M K, “3 Days Faculty Development Program on “Applying digital design basics to implement a rudimentary CPU” at PROXELERA, Mysuru from 15th to 17th May 2023.</li>\n \t<li style=\"text-align: justify;\">Kalathma M K, “5 Days Faculty Development Program on “PCB Design and IoT Applications” at BMSIT and Management, Bangalore from 6th to 10th Nov 2023.</li>\n \t<li style=\"text-align: justify;\">Ten Days Online Faculty Development Program on “Machine Learning for Data Science using Python”, organized by E&amp;ICT Academy and Dept. of Computer Science &amp; Engineering.&nbsp; NIT Warangal, Telangana from 15th to 24th May 2024.</li>\n \t<li style=\"text-align: justify;\">Five Days Faculty Development Program on “Generative AI Demystified: Tools and Techniques for NextGen Applications” organized by the Department of Computer Science &amp; Engineering in association with Wipfli LLP, India held during 20th to 24th January 2025 at NMAM Institute of Technology, Nitte.</li>\n \t<li style=\"text-align: justify;\">Three days Faculty Development Program on “Artificial Intelligence, Machine Learning and Deep Learning in the Data Revolution Era: Progress and Applications”, organized by the Department of CSE and Department of CSE-AI&amp;ML, held during 3<sup>rd</sup> to 5<sup>th</sup> February 2025 at ATME College of Engineering, Mysuru.</li>\n \t<li style=\"text-align: justify;\">Five days Faculty Development Program on “Cyber Security Awareness and Emerging Technologies for Secure Social Media and Banking Applications”, organized by Department of Electronics and Communication Engineering, held during 10<sup>th</sup> to 14<sup>th</sup> March 2025 at ATME College of Engineering, Mysuru.</li>\n \t<li style=\"text-align: justify;\">Two Weeks AICTE Recognized Faculty Development Program on “Refresher Course on Ethics and Innovation: Integrating AI in Science and Technology Research”, organized by Department of Applied Science, held during 19<sup>th</sup> to 30<sup>th</sup> May 2025 at NITTTR, Chandigarh.</li>\n \t<li style=\"text-align: justify;\">Kalathma M K, “6 Days Faculty Development Program in “Advance Cyber Security” at Cyberverse Foundation Mysuru, Organized by CySeck from 21 st to 26 th JULY 2025.</li>\n \t<li style=\"text-align: justify;\">Kalathma M K, “6 Days Faculty Development Program in “Insights and Applications at Maharaja Institute of Technology at Cyberverse Foundation Mysuru, organised by AICTE Training and Learning (ATAL) Academy from 5 st to 10 th JAN 2026.</li>\n</ol>\n<strong>&nbsp;</strong>\n<p style=\"text-align: left;\"><strong>MOOC Certification</strong></p>\n\n<ol>\n \t<li style=\"text-align: left;\">Introduction to Microprocessor &amp; Microcontroller</li>\n \t<li style=\"text-align: left;\">Introduction to Operation System</li>\n \t<li style=\"text-align: left;\">Introduction to IoT</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">PROPOSAL/FUNDING/PROJECT FINANCIAL ASSISTANCE</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>PATENT</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">Nil</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Institution's Register File( IR) member</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Faculty Placement Coordinator</li>\n \t<li>NBA Criteria 4 Coordinator</li>\n \t<li>IA Coordinator</li>\n \t<li>VTU/LIC visit Coordinator</li>\n \t<li>Student Mentor</li>\n \t<li>Class Teacher</li>\n \t<li>Perception Department Coordinator</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
