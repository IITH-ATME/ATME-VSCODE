  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>&nbsp;\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td><img class=\"aligncenter wp-image-25043 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2025/08/Mr.-Siddegowda-C.-J-2.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: <span style=\"text-decoration: underline; color: #333399;\">Siddegowda C J</span></strong></p>\n<p style=\"text-align: left;\"><strong>Designation:Asst. Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program:MCA</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience in years: </strong></p>\n\n<table class=\"alignleft\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td style=\"width: 158px;\"><strong>Teaching: 21</strong></td>\n<td style=\"width: 184px;\"><strong>Research: 5</strong></td>\n<td style=\"width: 168px;\"><strong>Industry: Nil</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td style=\"width: 147px; height: 1px; text-align: left;\"><strong>Email ID</strong></td>\n<td style=\"width: 286px; height: 1px; text-align: left;\"><strong>Official:<a href=\"mailto:siddegowdacj.mca@old.atme.edu.in\">siddegowdacj.mca@old.atme.edu.in</a></strong></td>\n<td style=\"width: 286px; height: 1px; text-align: left;\"><strong>Personal:<a href=\"mailto:siddegowdacj@gmail.com\">siddegowdacj@gmail.com</a></strong></td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Vidwan ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">224780</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 31px;\"><strong>Google Scholar ID</strong></td>\n<td style=\"width: 572px; height: 31px; text-align: left;\" colspan=\"2\"><strong><a href=\"mailto:siddegowdacj@gmail.com\">siddegowdacj@gmail.com</a> </strong>\n\n<a href=\"https://scholar.google.com/citations?user=OztMTpcAAAAJ&amp;hl=en\">https://scholar.google.com/citations?user=OztMTpcAAAAJ&amp;hl=en</a></td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Scopus ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Orcid ID</strong></td>\n<td style=\"width: 572px; height: 1px; text-align: left;\" colspan=\"2\"><a href=\"https://orcid.org/0000-0001-8206-9367?lang=en\" target=\"_blank\" rel=\"noopener\">0000-0001-8206-9367</a></td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Web of Science Researcher ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>LinkedIn ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration: underline; color: #333399;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></strong></span></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>Ph.D </strong>pursuing</li>\n \t<li style=\"text-align: left;\"><strong>MCA</strong></li>\n \t<li style=\"text-align: left;\"><strong><strong>B.Sc in computer science</strong></strong></li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 2; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Areas of Interest</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 3; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">Deep Learning</li>\n \t<li style=\"text-align: left;\">Networking</li>\n</ol>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 13; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\"><span style=\"font-size: 18px;\"><strong>Membership in Professional Bodies</strong></span></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 14; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.