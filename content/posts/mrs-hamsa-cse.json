  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><a href=\"https://old.atme.edu.in/mrs-hamsa-a-s/hamsa-a-s-1/\"><img class=\"aligncenter wp-image-16033 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/09/Hamsa-A-S-1.jpg\" alt=\"\" width=\"150\" height=\"200\" /></a></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: <span style=\"text-decoration: underline; color: #333399;\">Mrs. Hamsa A S</span></strong></p>\n<p style=\"text-align: left;\"><strong>Designation: </strong>Assistant Professor</p>\n<p style=\"text-align: left;\"><strong>Department</strong><strong>: </strong>Computer Science &amp; Engineering</p>\n<p style=\"text-align: left;\"><strong>Professional Experience: </strong>8+ Years in Teaching</p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"21%\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\" width=\"37%\"><strong>Official:</strong> <a href=\"mailto:hamsaas_CS@old.atme.edu.in\">hamsaas_CS@old.atme.edu.in</a></td>\n<td style=\"text-align: left;\" width=\"41%\"><strong>Personal: </strong><a href=\"mailto:hamsagowda.18@gmail.com\">hamsagowda.18@gmail.com</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"21%\"><strong>Orcid ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"78%\"><a href=\"https://orcid.org/0000-0002-0808-577X\">https://orcid.org/0000-0002-0808-577X</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"21%\"><strong>Google Scholar ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"78%\"><a href=\"https://scholar.google.co.in/citations?user=loD0yA0AAAAJ\">https://scholar.google.co.in/citations?user=loD0yA0AAAAJ</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"21%\"><strong>LinkedIn ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"78%\"><a href=\"https://www.linkedin.com/in/hamsa-a-s-64351032\">https://www.linkedin.com/in/hamsa-a-s-64351032</a></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><span style=\"text-decoration: underline; color: #333399;\"><strong>Qualification</strong></span></p>\n\n<ul style=\"text-align: left;\">\n \t<li>Pursuing <strong>Ph.D. </strong>in Cyber Security at <strong>VTU, Belgaum.</strong></li>\n \t<li><strong>M.Tech</strong> in Computer Science &amp; Engineering from <strong>BTL Institute of Technology, Bangalore.</strong></li>\n \t<li><strong>B.E</strong> in Computer Science &amp; Engineering from <strong>PES College of Engineering</strong>,<strong> Mandya.</strong></li>\n</ul>\n<p style=\"text-align: left;\"><span style=\"text-decoration: underline; color: #333399;\"><strong>Certification Courses</strong></span></p>\n\n<ul>\n \t<li style=\"text-align: left;\">Certified Python programmer from <strong>WileyNXT.</strong></li>\n \t<li style=\"text-align: left;\">Post-Graduate Certification in <strong style=\"font-size: revert; font-family: inherit;\">“Artificial Intelligence &amp; Machine Learning”</strong><span style=\"font-size: revert; font-family: inherit; font-weight: inherit;\"> from</span><strong style=\"font-size: revert; font-family: inherit;\"> Indian Institute of Technology (IIT-Mandi, Himachal Pradesh)</strong></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Membership in Professional Bodies</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\">Lifetime Member of Indian Society for Technical Education, <strong>MISTE</strong> <strong>since 2014.</strong></p>\n<p style=\"text-align: left;\"><strong>Membership Number: LM 94807</strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 2; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Research Areas of Interest</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 3; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">Cyber Security.</li>\n \t<li style=\"text-align: left;\">Computer Networks &amp; Security.</li>\n \t<li style=\"text-align: left;\">Artificial Intelligence &amp; Machine Learning.</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 4; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\"><strong><span style=\"font-size: 18px;\">Publications Details</span></strong></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 5; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: justify;\">Published a technical paper <strong>“LID SYSTEMS FOR SPEECH PROCESSING SYSTEM”</strong> (GMM based Bayes classifier model, FCN and CNN models to automatically recognize and classify the spoken language) in an international journal of creative research thoughts - <strong>IJCRT,</strong> <strong>(ISSN: 2320-2882, IJCRT | Volume 10, Issue 6 June 2022)</strong></li>\n \t<li style=\"text-align: justify;\">Published a technical paper <strong>“Collaboration of Blockchain in Healthcare 4.0”</strong> in an International Journal of Advanced Research in Computer and Communication Engineering - <strong>IJARCCE,</strong> <strong>(ISSN (O) 2278-1021, ISSN (P) 2319-5940 Vol. 11, Issue 6, June 2022)</strong></li>\n \t<li style=\"text-align: justify;\">Published a technical paper <strong>“Prognosis of Cardiovascular Disease using Machine Learning Approach” </strong>in a <strong>Scopus Journal</strong> - Tuijin Jishu/Journal of Propulsion Technology (<strong>ISSN: 1001-4055 Vol. 44 No. 5| 2023)</strong></li>\n \t<li style=\"text-align: justify;\">Published a technical paper <strong style=\"font-size: revert; font-family: inherit;\">“Implementation of Plant Disease Detection Using CNN Algorithm”</strong><span style=\"font-size: revert; font-family: inherit; font-weight: inherit;\"> in a </span><strong style=\"font-size: revert; font-family: inherit;\">Scopus Journal</strong><span style=\"font-size: revert; font-family: inherit; font-weight: inherit;\"> - Tuijin Jishu/Journal of Propulsion Technology (</span><strong style=\"font-size: revert; font-family: inherit;\">ISSN: 1001-4055 Vol. 44 No. 5| 2023)</strong></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">Honours/Awards/ Achievements</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: justify;\" valign=\"top\" width=\"100%\">Won the <strong>“Best Technical Paper Award”</strong> for the technical paper presented in an International Conference held by <strong>ANNA University, Chennai </strong>(ICRTCSE- 2012)</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB; mso-bidi-font-weight: bold;\"><strong><span lang=\"EN-GB\">FDPs/Conferences/Workshops/STTP/MOOC Certification/Online Courses</span></strong></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: justify;\">An AICTE Sponsored <strong>ATAL-FDP</strong> on <strong>“CYBER SECURITY” at UVCE</strong>, Bangalore.</li>\n \t<li style=\"text-align: justify;\">A Workshop on <strong>“Cybersecurity Engineering in Academics” at R.V. College of Engineering</strong>, Bangalore.</li>\n \t<li style=\"text-align: justify;\">A Workshop Attended on <strong>“Role of Blockchain and AI in the Application of Cyber Security”</strong> <strong>at MS Ramiah Institute of Technology</strong>, Bangalore.</li>\n \t<li style=\"text-align: justify;\">An AICTE Training and Learning Academy-<strong>ATAL</strong> Sponsored One week Faculty Development Program on <strong>“Cyber Security for Industry 4.0”</strong> <strong>at R.V. College of Engineering</strong>, Bangalore.</li>\n \t<li style=\"text-align: justify;\">An <strong>ATAL-FDP</strong> on <strong>“Inculcating Universal Human Values in Technical Education (UHV)”</strong> at <strong>ATME College of Engineering, </strong>Mysuru</li>\n</ul>\n<ul style=\"text-align: justify;\">\n \t<li>A Technical Paper Presented <strong>on “Handling Link Asymmetry in multi-hop mesh network”</strong> at T-John Institute of Technology, Bangalore.</li>\n</ul>\n<p style=\"text-align: justify;\"><span style=\"text-decoration: underline; color: #333399;\"><strong>MOOC Certification</strong></span></p>\n<p style=\"text-align: justify;\"><strong>NPTEL c</strong>ourse on<strong> “Cyber Security &amp; Privacy”</strong> is successfully completed with certificate <strong>(July-October 2023)</strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">Roles and Responsibilities: Institute Level </span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">NAAC Criteria – 4, CSE Department Coordinator.</li>\n \t<li style=\"text-align: left;\">Intellectual Property Rights – IPR, CSE_Department Coordinator.</li>\n \t<li style=\"text-align: left;\">Transport Committee Member.</li>\n \t<li style=\"text-align: left;\">Hostel Committee Member.</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">Roles and Responsibilities: Department Level</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">NBA Criteria – 2 In charge.</li>\n \t<li style=\"text-align: left;\">Students Mentor.</li>\n \t<li style=\"text-align: left;\">Worked as website Coordinator (2022-24)</li>\n \t<li style=\"text-align: left;\">Worked as NBA Criteria – 1 Coordinator (2022-23)</li>\n \t<li style=\"text-align: left;\">Worked as EMS Coordinator (2022-23)</li>\n \t<li style=\"text-align: left;\">Worked as Student Project Coordinator (2022-23)</li>\n \t<li style=\"text-align: left;\">Class Teacher Role for 3<sup>rd</sup> &amp; 5<sup>th</sup> semester (2021-22)</li>\n \t<li style=\"text-align: left;\">Department Activity updates (2021-22)</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
