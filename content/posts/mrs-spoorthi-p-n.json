  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><a href=\"https://old.atme.edu.in/?attachment_id=21209\" rel=\"attachment wp-att-20449\"><img class=\"aligncenter wp-image-21209 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2024/11/Spoorthi-P-N.jpg\" alt=\"\" width=\"150\" height=\"200\" /></a></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Mrs. SPOORTHI P N</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Electronics &amp; Communication Engineering </strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 1.5 years</strong></p>\n\n<table class=\" alignleft\">\n<tbody>\n<tr>\n<td width=\"158\"><strong>Teaching: 0</strong></td>\n<td width=\"184\"><strong>Research: 0</strong></td>\n<td width=\"168\"><strong>Industry: 1.5years</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table width=\"100%\">\n<tbody>\n<tr>\n<td width=\"28%\">Email ID</td>\n<td width=\"32%\">Official: <a href=\"mailto:spoorthipn.ec@old.atme.edu.in\">spoorthipn.ec@old.atme.edu.in</a></td>\n<td width=\"38%\">Personal: <a href=\"mailto:pnspoorthi@gmail.com\">pnspoorthi@gmail.com</a></td>\n</tr>\n<tr>\n<td width=\"28%\">Vidwan ID</td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"71%\"><a href=\"https://vidwan.inflibnet.ac.in/profile/582725/NTgyNzI1\">https://vidwan.inflibnet.ac.in/profile/582725/NTgyNzI1</a></td>\n</tr>\n<tr>\n<td width=\"28%\">Google Scholar ID</td>\n<td colspan=\"2\" width=\"71%\"></td>\n</tr>\n<tr>\n<td width=\"28%\">Scopus ID</td>\n<td colspan=\"2\" width=\"71%\"></td>\n</tr>\n<tr>\n<td width=\"28%\">Orcid ID</td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"71%\"><a href=\"http://www.orcid.org/0000-0002-7303-7969\">http://www.orcid.org/0000-0002-7303-7969</a></td>\n</tr>\n<tr>\n<td width=\"28%\">Web of Science Researcher ID</td>\n<td colspan=\"2\" width=\"71%\"></td>\n</tr>\n<tr>\n<td width=\"28%\">LinkedIn ID</td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"71%\"><a href=\"https://www.linkedin.com/in/yogesh-n-8a2a10201\">https://www.linkedin.com/in/yogesh-n-8a2a10201</a></td>\n</tr>\n</tbody>\n</table>\n<span style=\"color: #ffffff;\"><strong>Roles and Responsibilities: Institute Level</strong></span>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<h3 class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration-line: underline; color: #333399;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></strong></span></h3>\n<ul>\n \t<li style=\"text-align: left;\">Post-Graduation (Master of Technology) in Automotive Electronics Engineering from JSSSTU in 2021.</li>\n \t<li style=\"text-align: left;\">Bachelor of Engineering in Electronics and Communication Engineering from VTU in 2019.</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">Embedded Systems</li>\n \t<li style=\"text-align: left;\">Control systems</li>\n \t<li style=\"text-align: left;\">Automotive Electronics</li>\n \t<li style=\"text-align: left;\">Artificial Intelligence</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 2; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Publication Details</strong></span></td>\n</tr>\n<tr style=\"mso-yfti-irow: 3; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">Spoorthi P N, yashwanth S D, “Intelligent Traffic Management System”,5th International Conference on Electrical, Electronics, Communication, Computer Technologies and Optimization Techniques (ICEECCOT) 10-11, ISSN 978-1-6654-3272 February 2022.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>FDPs/Conferences/Workshops/STTP/MOOC Certification</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline;\">Conferences</span></strong></p>\n\n<ol>\n \t<li style=\"text-align: left;\">National Conference on Recent Trends in, Electrical, Instrumentation, Electronics and Communication” NCRTEIEC – 2019, held at Dr. Ambedkar Institute of Technology, Bengaluru</li>\n \t<li style=\"text-align: left;\">5th IEEE International Conference on Electrical, Electronics, Communication, Computer Technologies and Optimization Techniques (ICEECCOT-2021) held at GSSSIETW during 10th &amp; 11th December 2021</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Roles and Responsibilities: Department Level</strong></span></td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">Hackathon Coordinator</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>",
