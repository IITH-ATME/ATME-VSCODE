  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table style=\"height: 301px;\" width=\"986\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-6920 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/Mr.-Ramachandra-M-N.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: RAMACHANDRA M N</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Physics</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: </strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching: 20</strong></td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research: 5</strong></td>\n<td style=\"text-align: left;\" width=\"168\"><strong>Industry:</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Official: </strong><a href=\"mailto:ramachandramn_phy@old.atme.edu.in\">ramachandramn_phy@old.atme.edu.in</a></td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Personal: &nbsp;</strong><a href=\"mailto:ramu.mnr@gmail.com\">ramu.mnr@gmail.com</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Vidwan ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"https://vidwan.inflibnet.ac.in/profile/202647\">https://vidwan.inflibnet.ac.in/profile/202647</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Google Scholar ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><u><a href=\"https://scholar.google.co.in/citations?user=NrZnWoMAAAAJ\">&nbsp;https://scholar.google.co.in/citations?user=NrZnWoMAAAAJ</a></u></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Scopus ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><u><a href=\"http://www.scopus.com/authid/detail.url?authorId=57216847437\">http://www.scopus.com/authid/detail.url?authorId=57216847437</a> </u></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Orcid ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><u><a href=\"http://www.orcid.org/0000-0001-7373-8047\">h