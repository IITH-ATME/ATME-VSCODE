  "content": "<h3 style=\"text-align: center;\"><span style=\"text-decoration: underline; color: #333399;\">Faculty Details</span></h3>\n<p style=\"text-align: justify;\">[vc_row][vc_column][vc_column_text]<script src=\"https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js\"></script> <script src=\"https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js\"><span data-mce-type=\"bookmark\" style=\"display: inline-block; width: 0px; overflow: hidden; line-height: 0;\" class=\"mce_SELRES_start\">﻿</span></script></p>\n\n<div class=\"table-responsive\" style=\"text-align: justify;\">\n<div data-type-content=\"wpdt-html-content\">\n<div class=\"row\">\n<div class=\"col-4 col-lg-4 col-sm-4\">\n<p class=\"MsoNormal\"><strong style=\"mso-bidi-font-weight: normal;\"><a href=\"https://old.atme.edu.in/ms-amitha-s/amitha-s-2/\" rel=\"attachment wp-att-20219\"><img class=\"aligncenter size-full wp-image-20219\" src=\"https://old.atme.edu.in/wp-content/uploads/2024/06/Amitha-S-2.jpg\" alt=\"\" width=\"150\" height=\"200\" /></a></strong></p>\n\n</div>\n<div class=\"col-8 col-lg-8 col-sm-8\">\n<p class=\"MsoNormal\"><strong style=\"mso-bidi-font-weight: normal;\"><span lang=\"EN-US\" style=\"font-size: 12.0pt; mso-bidi-font-size: 11.0pt; line-height: 115%; font-family: 'Times New Roman',serif;\">Faculty Name:</span><span style=\"text-decoration: underline; color: #333399;\">Ms. Amitha S</span></strong></p>\n<p class=\"MsoNormal\"><strong style=\"mso-bidi-font-weight: normal;\"><span lang=\"EN-US\" style=\"font-size: 12.0pt; mso-bidi-font-size: 11.0pt; line-height: 115%; font-family: 'Times New Roman',serif;\">Designation: Assistant Professor</span></strong></p>\n<p class=\"MsoNormal\"><strong style=\"mso-bidi-font-weight: normal;\"><span lang=\"EN-US\" style=\"font-size: 12.0pt; mso-bidi-font-size: 11.0pt; line-height: 115%; font-family: 'Times New Roman',serif;\">Program: Computer Science &amp; Engineering</span></strong></p>\n<p class=\"MsoNormal\"><strong style=\"mso-bidi-font-weight: normal;\"><span lang=\"EN-US\" style=\"font-size: 12.0pt; mso-bidi-font-size: 11.0pt; line-height: 115%; font-family: 'Times New Roman',serif;\">Professional Experience:</span></strong></p>\n\n<table width=\"100%\">\n<tbody>\n<tr>\n<td width=\"40%\"><strong>Teaching</strong></td>\n<td width=\"28%\"><strong>Research</strong></td>\n<td width=\"31%\"><strong>Industry</strong></td>\n</tr>\n<tr>\n<td width=\"40%\">2 years 5 months</td>\n<td width=\"28%\"></td>\n<td width=\"31%\"></td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<h3 class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB; mso-bidi-font-weight: bold;\">Academic Details</span></h3>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration: underline; color: #333399;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></strong></span></p>\n\n<ul type=\"disc\">\n \t<li class=\"MsoNormal\" style=\"line-height: normal; background: white; text-align: left;\">B.E   Vidya Vikas Institute of Engineering and Technology, Mysore.</li>\n \t<li class=\"MsoNormal\" style=\"line-height: normal; background: white; text-align: left;\">M.Tech   National Institute of Engineering, Mysuru.</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 4; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<h3 class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong style=\"mso-bidi-font-weight: normal;\"><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">FDPs/Conferences/Workshops/STTP/MOOC Certification/Online Courses</span></strong></h3>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 5; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: left;\">​<span style=\"text-decoration: underline; color: #333399;\"><strong>Certification Courses</strong></span></p>\n\n<ol style=\"text-align: left;\">\n \t<li>Completed four week course in Coursera -<em>“What is Data Science?”</em></li>\n \t<li>Completed four week course in Coursera - <em>“Data Warehousing and Business Intelligence”</em></li>\n \t<li>Completed one week course in Coursera - <em>“Introduction to Project Management”</em></li>\n</ol>\n<p style=\"text-align: left;\"><span style=\"text-decoration: underline; color: #333399;\"><strong>FDP/ Workshops/Seminar</strong></span></p>\n\n<ol>\n \t<li style=\"text-align: left;\">Attended FDP on “<em>From Ideas, IP to Pitching</em>” on 21st to 26th August 2023 from National Institute of Engineering, Mysuru.</li>\n \t<li style=\"text-align: left;\">Attended FDP on “<em>Cloud Infrastructure</em>” on 21st to 25th August 2023 from National Institute of Engineering in collaboration with Brainvision Solutions India Pvt Ltd and AICTE, Mysuru.</li>\n \t<li style=\"text-align: left;\">Attended FDP on “<em>Full Stack Development</em>” on 21st to 31st March 2023 from National Institute of Engineering, Mysuru.</li>\n \t<li style=\"text-align: left;\">Attended FDP on “<em>Recent Trends in Cyber Security &amp; Blockchain Technology</em>” on 20th to 22nd July 2023 from National Institute of Engineering, Mysuru.</li>\n \t<li style=\"text-align: left;\">Attended Workshop on <em>“Digital Creativity Skills</em>”, as a part of Adobe Academic Essentials program.</li>\n</ol>\n&nbsp;</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>",
