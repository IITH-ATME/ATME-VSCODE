  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-24502 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2025/08/Madhurya-B-Eshwar-2.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><span style=\"color: #000000;\"><strong>Faculty Name: Madhurya B Eshwar</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"color: #000000;\"><strong>Designation: Assistant Professor</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"color: #000000;\"><strong>Program: Electronics and Communication Engineering</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"color: #000000;\"><strong>Professional Experience: </strong></span></p>\n\n<table class=\" alignleft\">\n<tbody>\n<tr>\n<td width=\"158\"><span style=\"color: #000000;\"><strong>Teaching: 5years</strong></span></td>\n<td width=\"184\"><span style=\"color: #000000;\"><strong>Research:</strong></span></td>\n<td width=\"168\"><span style=\"color: #000000;\"><strong>Industry:</strong></span></td>\n</tr>\n</tbody>\n</table>\n<p style=\"text-align: left;\">&nbsp;</p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\"><a href=\"madhuryabeshwar.ec@old.atme.edu.in\">Official: <strong>madhuryabeshwar.ec@old.atme.edu.in</strong></a></td>\n<td style=\"text-align: left;\">Personal: <a href=\"mailto:madhuryaharish@gmail.com\"><strong>madhuryaharish@gmail.com</strong></a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Vidwan ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Google Scholar ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Scopus ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Orcid ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Web of Science</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Orcid ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>LinkedIn ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><span style=\"color: #000000;\"><strong>M.Tech</strong> in Digital Electronics and Communication Systems</span></li>\n \t<li style=\"text-align: left;\"><span style=\"color: #000000;\"><strong style=\"font-family: inherit; font-size: inherit;\">B.E</strong><span style=\"font-family: inherit; font-size: inherit;\"> in Electronics and Commnication</span></span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\"><span style=\"color: #000000;\">Networking</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li><span style=\"color: #000000;\">\"A New trustworthy and co-operative nodes based MIMO route discovery algorithm for WSN\", International Journal of Emerging Technology and Advanced Engineering, Vol.3, Issue 5, pp.713-717, May-2013.</span></li>\n \t<li><span style=\"color: #000000;\">\"A new co-operative nodes based route discovery and game theory based routing algorithm for WSN\", International Conference on Electronics and Communication Engineering (ICECE 2013), pp 179-183, April-2013.</span></li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\"><span style=\"color: #000000;\">Participated in ATAL Academy FDP on “Innovative VLSI Paradigms: MEMS, 3D ICs and AI driven design” at VVIET, Mysuru.</span></li>\n \t<li style=\"text-align: left;\"><span style=\"color: #000000;\">Participated in three day national level FDP on “Indian Knowledge System” at ATMECE, Mysuru</span></li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Honours/Awards/ Achievements</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">&nbsp; <span style=\"color: #000000;\">VTU second rank in M.Tech</span></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
