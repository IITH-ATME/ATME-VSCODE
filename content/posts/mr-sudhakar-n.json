  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table style=\"height: 301px;\" width=\"986\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-25295 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/09/Sudhakar-N-1.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Sudhakar N</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor &amp; HOD</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Mathematics</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: &nbsp;</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching:&nbsp; </strong>24 Years</td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research: 2</strong> Years</td>\n<td style=\"text-align: left;\" width=\"168\"><strong>Industry: </strong>Nil</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td width=\"147\"><strong>Email ID</strong></td>\n<td width=\"286\"><strong>Official:</strong> <a href=\"mailto:sudhakarn_maths@old.atme.edu.in\">sudhakarn_maths@old.atme.edu.in</a></td>\n<td width=\"286\"><strong>Personal:</strong> <a href=\"mailto:sudhakardixith@gmail.com\">sudhakardixith@gmail.com</a></td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Vidwan ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://vidwan.inflibnet.ac.in/profile/201863\">https://vidwan.inflibnet.ac.in/profile/201863</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Google Scholar ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://scholar.google.com/citations?user=ZXyhp_UAAAAJ&amp;hl=en\">https://scholar.google.com/citations?user=ZXyhp_UAAAAJ&amp;hl=en</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Scopus ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Orcid ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://orcid.org/orcid-search/search?searchQuery=0000-0002-4006-8785\">https://orcid.org/orcid-search/search?searchQuery=0000-0002-4006-8785</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Web of Science Researcher ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">LinkedIn ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://linkdin.com.in/sudhakar-n-a093a5176\">https://linkdin.com.in/sudhakar-n-a093a5176</a></p>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>Pursuing Ph.D. in&nbsp;&nbsp; Operation Research</strong></li>\n \t<li style=\"text-align: left;\"><strong>M. Sc</strong> in Mathematics</li>\n \t<li style=\"text-align: left;\"><strong style=\"font-family: inherit; font-size: inherit;\">B.Sc</strong><span style=\"font-family: inherit; font-size: inherit;\"> in &nbsp;Mathematics</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">\n<ol>\n \t<li>Operation Research</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: justify;\"><b>NIL</b></p>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><strong><span style=\"color: #ffffff;\">Membership in Professional Bodies</span></strong></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: left;\">Life member in ISTE</p>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Attended three days FDP on Essentials of Sciences for Engineering and Research -2025 in ATMECE from 15th Jan to 17th Jan 2025.</li>\n \t<li style=\"text-align: justify;\">Attended five days FDP on Essentials of Sciences for Engineering and Research -2024 in ATMECE from 26th Feb 2024 to 1st March 2024.</li>\n \t<li style=\"text-align: justify;\">Attended three days FDP on “Importance of NAAC Accreditation in Higher Education Institutions” organized by ATME College of Engineering, Mysuru from 9 to 11-11-2020.</li>\n \t<li style=\"text-align: justify;\">Attended three-day webinar on “Current Trends in Applied Mathematics” from 21st to 23rd September 2020 by MIT, Mysore.</li>\n \t<li style=\"text-align: justify;\">Attended Three days National Level Online FDP on “AICTE Exam Reforms –An overview” by Department of Mechanical Engineering, ATMECE, Mysuru from 27th to 29th August 2020.</li>\n \t<li style=\"text-align: justify;\">Attended Five day FDP on “Mathematics Concepts by Using Free Open Source Software’s(FOSS) organized by BMSIT&amp;M, Bengaluru from 21st to 25th July 2020</li>\n \t<li style=\"text-align: justify;\">Attended TEQIP 1.3 sponsored 5 days’ program on “Outcome Based Education and NBA Accreditation” from 7th to 11th Jan 2020 at GSSS Institute of Engineering &amp;Technology for women, Mysuru.</li>\n \t<li style=\"text-align: justify;\">Attended Three day ADMA National pre-conference workshop on Recent Advances in signed Graphs and their Applications sponsored by TEQIP from 6th to 8th June 2016.</li>\n \t<li style=\"text-align: justify;\">Attended two day UGC sponsored National conference on “Energy of Graphs” organized by Department of Mathematics, Maharani’s Science college for women, Mysuru from 11th and 12th March 2016.</li>\n</ol>\n<p style=\"text-align: justify;\"><strong>MOOC CERTIFICATION:</strong></p>\n\n<ol>\n \t<li style=\"text-align: justify;\">Online Course on “Student Assessment and Evaluation”</li>\n \t<li style=\"text-align: justify;\">Online Course on “Technology Enabled Learning &amp; Life-long Self-learning”</li>\n \t<li style=\"text-align: justify;\">Online Course on “Orientation towards Technical Education &amp; Curriculum Aspects”</li>\n \t<li style=\"text-align: justify;\">Online Course on “Regression Analysis” online mode at NPTEL-AICTE from July-Oct 2019.</li>\n \t<li style=\"text-align: justify;\">Online Course on “Calculus of several Real Variables” online mode at NPTEL-AICTE from Aug-Oct 2019.</li>\n \t<li style=\"text-align: justify;\">Online course on “The Joy of Computing using Python” during Jan-Apr 2024 by NPTEL-AICTE.</li>\n \t<li style=\"text-align: justify;\">Online course on “Constrained and unconstrained optimization” during Jan-Apr 2023 by NPTEL-AICTE.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Proposal/Funding/Project Financial Assistance</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Honours/Awards/ Achievements</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Grievance Redressal Committee</li>\n \t<li>SC-ST Committee</li>\n \t<li>Library Committee</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>In charge HOD of Mathematics</li>\n \t<li>Mentor</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>",
