  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>&nbsp;\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><a href=\"https://old.atme.edu.in/yeshashwini-bhandari-k-r/pavithra-m-s/\" rel=\"attachment wp-att-20179\"><img class=\"aligncenter size-full wp-image-20179\" src=\"https://old.atme.edu.in/wp-content/uploads/2024/06/Pavithra-M-S.jpg\" alt=\"\" width=\"150\" height=\"200\"></a></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: <span style=\"text-decoration: underline; color: #333399;\">Dr Pavithra M S</span></strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Associate Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Master of Computer Applications (MCA)</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience in years: </strong></p>\n\n<table class=\"alignleft\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td style=\"width: 158px;\"><strong>Teaching: 12</strong></td>\n<td style=\"width: 184px;\"><strong>Research:3</strong></td>\n<td style=\"width: 168px;\"><strong>Industry: NIL</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; hei