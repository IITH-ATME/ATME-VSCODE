  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table style=\"height: 301px;\" width=\"986\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-27993 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/03/Ms.-Bharathi-R-1.jpg.jpeg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: &nbsp;Ms. R. Bharathi</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Lecturer</strong></p>\n<p style=\"text-align: left;\"><strong>Program: English</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: </strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching:&nbsp; </strong>19Years</td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research: </strong>Nil</td>\n<td width=\"168\">\n<p style=\"text-align: left;\"><strong>Industry: </strong>7 Years</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p style=\"text-align: left;\">&nbsp;</p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Email ID</strong></p>\n</td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Official:</strong>\n\n<a href=\"mailto:bharathir_hu@old.atme.edu.in\"><strong>bharathir_hu@old.atme.edu.in</strong></a></td>\n<td width=\"286\">\n<p style=\"text-align: left;\"><strong>Personal:</strong></p>\n<p style=\"text-align: left;\"><a href=\"mailto:bharathib980@gmail.com\"><strong>bharathib980@gmail.com</strong></a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Vidwan ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://vidwan.inflibnet.ac.in//profile/201857\">https://vidwan.inflibnet.ac.in//profile/201857</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Google Scholar ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://scholar.google.com/citations?hl=en&amp;user=-mZfj68AAAAJ\">https://scholar.google.com/citations?hl=en&amp;user=-mZfj68AAAAJ</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Scopus ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Orcid ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://orcid.org/0000-0001-5962-6559\">https://orcid.org/0000-0001-5962-6559</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Web of Science Researcher ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">LinkedIn ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"http://www.linkedin.com/in/bharathi-b-374b79264\">www.linkedin.com/in/bharathi-b-374b79264</a></p>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\">MSc in Chemistry B.Ed.</li>\n \t<li style=\"text-align: left;\">M.A in English</li>\n \t<li style=\"text-align: left;\">PGDE in English</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">\n<ol>\n \t<li>Poetry, travel log</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Bharathi:- Paper-1 &nbsp;Title: The Impact of Social Media on Modern English Usage:A Linguistic Perspective . Published in IJCRT(<a href=\"http://www.ijcrt.org)&amp;\">www.ijcrt.org)&amp;</a> 7.97Impact factor by Google Scholar.Volume 12 Issue:10<sup>th</sup> October Published&nbsp; 7<sup>th</sup> Oct -2024.UGC Approved Journal:49023(18). Paper ID: IJCRT2410101 Registration ID:269820, ISSN;2320-2882.</li>\n \t<li style=\"text-align: justify;\">Bharathi:- Paper-II Title: FLUCTUATING MOODS OF ABHA,AS REPRESENTED IN THE SHORTSTORY”ABHA” TAKEN FROM “GULAMI TALKIES AND OTHER STORIES”</li>\n \t<li style=\"text-align: justify;\">Published in IJCRT(<a href=\"http://www.ijcrt.org)&amp;\">ijcrt.org)&amp;</a> 7.97 Impact factor by Google Scholar.Volume 13 Issue:3rd March 2025</li>\n \t<li style=\"text-align: justify;\">Published on 14<sup>th</sup> March 2025..UGC Approved Journal:49023(18). Paper ID: IJCRT2410101 Registration ID:269820, ISSN;2320-2882.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><strong><span style=\"color: #ffffff;\">Membership in Professional Bodies</span></strong></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Attended three days FDP on Essentials of Sciences for Engineering and Research -2025 in ATMECE from 15<sup>th</sup> Jan 2025 to 17<sup>th</sup> Jan 2025.</li>\n \t<li style=\"text-align: justify;\">Attended five days FDP on Essentials of Sciences for Engineering and Research -2024 in ATMECE from 26<sup>th</sup> Feb 2024 to 1<sup>st</sup> March 2024</li>\n \t<li style=\"text-align: justify;\">Attended three days FDP on “Importance of NAAC Accreditation in Higher Education Institutions” organised by ATME College of Engineering, Mysuru from 9 to 11-11-2020.</li>\n \t<li style=\"text-align: justify;\">Three Day National Level Online Faculty Development Program on \"AICTE Exam Reforms:An Overview\"-ATMECE from 27.08.2020 to 29.08.2020</li>\n \t<li style=\"text-align: justify;\">Annual Refresher Programme in Pedagogical Innovations And Research Methodology</li>\n \t<li style=\"text-align: justify;\">Attended 3 days and 7 days “Faculty Development for Student Induction” from 24-26 June 2019 and 23-29 July 2019 in Belagavi and Sri Venkateshwara College of Engineering, Bangalore respectively</li>\n \t<li style=\"text-align: justify;\">.Mooc _1 : Complete English course-Master English Beginner to Advaned -From Udemy</li>\n \t<li style=\"text-align: justify;\">Attened ‘GLOBAL TRADE WAR AND ECONOMIC UNCERTAINTY – A National level Webinar in JSS&nbsp; college for Women,</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Proposal/Funding/Project Financial Assistance</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Honours/Awards/ Achievements</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: justify;\"><b>NIL</b></p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">1.Member: College Canteen &amp; Convenience shop Committee\n\n2.Member: College cultural Committee\n\n3.Member; Anti Ragging Committee\n\n4.Member: Sports and Extra Curricular activity Committee\n\n5.Member: Admission and Transport Committee</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Class Teacher</li>\n \t<li>Mentor: For Students</li>\n \t<li>UHV: Co-ordinator of Basic science and Humanities</li>\n \t<li>Member of Scholarship Awareness Committee</li>\n \t<li>Course Co-ordinator</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>",
