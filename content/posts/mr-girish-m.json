  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-24575 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/09/Mr.-Girish-M-2.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: GIRISH M</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Electronics and Communication Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: </strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching: 10</strong></td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research: </strong></td>\n<td width=\"168\">\n<p style=\"text-align: left;\"><strong>Industry: </strong></p>\n</td>\n</tr>\n</tbody>\n</table>\n<p style=\"text-align: left;\">&nbsp;</p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Official: <a href=\"mailto:girishm_ec@old.atme.edu.in\">girishm_ec@old.atme.edu.in</a></strong></td>\n<td width=\"286\"><strong>Personal: <a href=\"mailto:girishmatme@gmail.com\">girishmatme@gmail.com</a> </strong></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Vidwan ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><u><a href=\"https://vidwan.inflibnet.ac.in/profile/201866\">https://vidwan.inflibnet.ac.in/profile/201866</a></u></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Google Scholar ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><u><a href=\"https://scholar.google.com/citations?user=HFf8vrIAAAAJ&amp;hl=en\">https://scholar.google.com/citations?user=HFf8vrIAAAAJ&amp;hl=en</a></u></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Scopus ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"https://www.scopus.com/authid/detail.uri?authorId=57215744207\">https://www.scopus.com/authid/detail.uri?authorId=57215744207</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Orcid ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><u><a href=\"https://orcid.org/0000-0002-3681-1513\">https://orcid.org/0000-0002-3681-1513</a></u></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>LinkedIn ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"https://www.linkedin.com/in/girish-m-53493078/\">https://www.linkedin.com/in/girish-m-53493078/</a></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>M.Tech</strong> in Digital Electronics and Communication Systems</li>\n \t<li style=\"text-align: left;\"><strong style=\"font-family: inherit; font-size: inherit;\">B.E</strong><span style=\"font-family: inherit; font-size: inherit;\"> in Electronics and Communication Engineering</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">\n<ul>\n \t<li>Embedded Systems</li>\n \t<li>Electromagnetics, Microwaves, and antenna</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: justify;\">Rural E-learning: An Efficient Strategy To Educate Farmers Or Villagers, conference paper ICRTST, Year 2022</li>\n \t<li style=\"text-align: justify;\">IoT BUILDING MANAGEMENT SYSTEM FOR SCIENCE AND TECHNLOGY INOVATIVE HUB FOR RURAL DEVELOPMENT, conference proceedings ICRTST, Year 2022</li>\n \t<li style=\"text-align: justify;\">5G Phased-array Beamforming Antenna Design for Future Communication technologies, conference proceedings ICRTST, Year 2021</li>\n \t<li style=\"text-align: justify;\">ARDUINO BASED AQUARIUM MONOTORING SYSTEM , journal article, &nbsp;IRJET, Year 2019</li>\n \t<li style=\"text-align: justify;\">Switching Control of Multi- LQRs for UPFC in Power System, conference paper International Conference for Convergence in Technology 2018, Volume 6, Year 2018</li>\n \t<li style=\"text-align: justify;\">Double stegging design to hide message in video using AES and DWT methods, conference paper IEEE, Year 2018</li>\n \t<li style=\"text-align: justify;\">Vehicular Communication Based Intelligent Collision Warning System, article IJCAR, Year 2018</li>\n \t<li style=\"text-align: justify;\">EFFICIENT APPROACH FOR DIGITAL AUDIO WATERMARKING SCHEME, article IJCRT, Year 2018</li>\n \t<li style=\"text-align: justify;\">Automated Toll Collection per Kilometer in Toll Plaza, article IJSRD, Year 2018</li>\n \t<li style=\"text-align: justify;\">Word Repetition Analysis in Stuttered Speech Using MFCC and Dynamic Time Warping, International Journal of Science, Engineering and Technology (IJSET),PP 2395-4752.</li>\n \t<li style=\"text-align: justify;\">Image Compression using AMBTC, article International Journal of Electronics, Electrical and Computational System, Volume 5, Year 2016</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><strong><span style=\"color: #ffffff;\">Membership in Professional Bodies</span></strong></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: left;\">Indian Society for Technical Education (ISTE) Lifetime member</p>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>One week FDP on Introduction to Swift Language</li>\n \t<li>One week FDP on Recent Trends in IoT and Cloud Computing</li>\n \t<li>Two-week FDP on Python</li>\n \t<li>One week FDP on Machine Learning using Python</li>\n \t<li>One week FDP on contemporary tools in Education 4.0</li>\n \t<li>Conducted four-week internship program on LabVIEW and Its Applications</li>\n \t<li>Conducted 3 Day workshop on Advanced Embedded Systems using NI LabVIEW</li>\n \t<li>Organized Three-day FDP on Importance of NAAC Accreditation in HEI</li>\n \t<li>Organized three Day FDP on Intellectual Property Rights in Education</li>\n \t<li>Participated one week workshop on Industry export management system conducted by DIC, Mysore</li>\n \t<li>Participated one week workshop on NAAC conducted by Govt Tool Room, Jharkhand</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Honours/Awards/ Achievements</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li>Best Paper Award, KIT, Tiptur</li>\n \t<li>Obtained CLAD (Certified LabVIEW Associate Developer) Certification from NI LabVIEW.</li>\n \t<li>Guided Project on “Automated toll collection per Kilometer in toll plaza” is Approved and Sanctioned with fund from Govt. body KSCST</li>\n \t<li>Guided Project on “Intellivision: Blind Assist System” is Approved and Sanctioned with fund from Govt. body KSCST</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Proposal/Funding/Project Financial Assistance</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li>Intellivision: Blind Assist System 2023-24 funded by KSCST</li>\n \t<li>Finalist for Young Professional Policy scheme proposal submitted on “Centre of Excellence for Advanced Embedded Systems using LabVIEW in 2021-22</li>\n \t<li>Automated Toll Collection per Kilometer in Toll Plaza funded by KSCST SPP in the year 2017-18</li>\n \t<li>Proposal got shortlisted as finalist under YPP in Department Science and Technology</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li>Member of Accreditation Committee</li>\n \t<li>Member of Internal Quality Assurance Cell (IQAC)</li>\n \t<li>Member of Project Competition &amp; Exhibition Committee</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li>Project and Seminar Evaluation Committee member</li>\n \t<li>DAB Committee Member Secretary</li>\n \t<li>Department of NBA &amp; NAAC Coordinator</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>",
