  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>&nbsp;\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td><img class=\"aligncenter wp-image-25039 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2025/08/Mr.-Hemantha-Kumar-B.-N-2.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: <span style=\"text-decoration: underline; color: #333399;\">Hemantha Kumar B N</span></strong></p>\n<p style=\"text-align: left;\"><strong>Designation:Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program:Master of Computer Applications</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 23 Years</strong></p>\n\n<table class=\"alignleft\" border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td style=\"width: 158px;\"><strong>Teaching:20 Years</strong></td>\n<td style=\"width: 184px;\"><strong>Research: 2 Years</strong></td>\n<td style=\"width: 168px;\"><strong>Industry: 3 Years</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td style=\"width: 147px; height: 1px; text-align: left;\"><strong>Email ID</strong></td>\n<td style=\"width: 286px; height: 1px; text-align: left;\"><strong>Official:</strong> <strong>h<a href=\"mailto:emanthkumarbn.mca@old.atme.edu.in\">emanthkumarbn.mca@old.atme.edu.in</a></strong></td>\n<td style=\"width: 286px; height: 1px; text-align: left;\"><strong>Personal:<a href=\"mailto:hemanth99@rediffmail.com\">hemanth99@rediffmail.com</a></strong></td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Vidwan ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 31px; text-align: left;\"><strong>Google Scholar ID</strong></td>\n<td style=\"width: 572px; height: 31px; text-align: left;\" colspan=\"2\"><a href=\"https://scholar.google.co.in/scholar?scilib=1&amp;hl=en\">https://scholar.google.co.in/scholar?scilib=1&amp;hl=en</a></td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px; text-align: left;\"><strong>Scopus ID</strong></td>\n<td style=\"width: 572px; height: 1px; text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px; text-align: left;\"><strong>Orcid ID</strong></td>\n<td style=\"width: 572px; height: 1px; text-align: left;\" colspan=\"2\">0009-0000-7826-5939</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>Web of Science Researcher ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"width: 147px; height: 1px;\"><strong>LinkedIn ID</strong></td>\n<td style=\"width: 572px; height: 1px;\" colspan=\"2\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration-line: underline; color: #333399;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></strong></span></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>P.hD</strong>(Persuing) in Computer Science</li>\n \t<li style=\"text-align: left;\"><strong>M.Phil. in Computer Science</strong></li>\n \t<li style=\"text-align: left;\"><strong>M. C. A (Master of Computer Applications)</strong></li>\n \t<li style=\"text-align: left;\"><strong style=\"font-family: inherit; font-size: inherit;\">B.Sc</strong><span style=\"font-family: inherit; font-size: inherit;\"> in Electronics</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Publication Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Published Scopus Indexed Paper Titled “Advancing Medical Imaging with Capsule Networks for Diagnostic Accuracy”, 20<sup>th</sup> April <a href=\"https://www.ijcesen.com/index.php/ijcesen/article/view/1082, DOI: 10.22399/ijcesen.1802\">https://www.ijcesen.com/index.php/ijcesen/article/view/1082, DOI: 10.22399/ijcesen.1802</a></li>\n \t<li style=\"text-align: justify;\">“Paddy Leaf Disease Classification using Neural Networks with Optimized Feature Selection Process” DOI: 10.15680/IJIRSET.2024.1307094 Volume 13 , issue 7,July 2024</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 2; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Areas of Interest</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 3; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"margin-left: 12pt; text-align: left;\">Artificial Intelligence, Machine learning and Deep Learning</p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 13; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\"><span style=\"font-size: 18px;\"><strong>Membership in Professional Bodies</strong></span></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 14; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul type=\"disc\">\n \t<li style=\"text-align: left;\">IAENG Membership&nbsp;ID- 362322.</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 4; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\"><span style=\"font-size: 18px;\"><strong>Honours/Awards/</strong></span><strong><span style=\"font-size: 18px;\"> Achievements</span></strong></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 5; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">“Best Teacher Award “&nbsp; From ROTARACT Club Mysore.</li>\n \t<li style=\"text-align: justify;\">Published Text Book Title “Advanced Web Programming “ with ISBN – 9789351634164</li>\n</ol>\n<div style=\"clear: both;\">&nbsp;</div></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 4; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">FDPs/Conferences/Workshops/STTP/MOOC Certification/Online Courses</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 5; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\"><strong>National Level Faculty Development Programme (FDP)</strong>on the theme&nbsp;“AI-Powered Research Excellence, ”<strong>July 21 to 25, 2025</strong>, organised by the&nbsp;Internal Quality Assurance Cell of De Paul College in association with the Xavier Board&nbsp;of Higher Education in India.</li>\n \t<li style=\"text-align: justify;\">Presented paper entitled “CNN-Based Autonomous Smart Drones for Precision Agriculture and Crop Monitoring” in 5h International Conference on Intelligent Technologies (CONIT 2025) during 20th to 22nd June 2025. KLE Institute of Technology,Hubballi</li>\n \t<li style=\"text-align: justify;\">Presented paper in TechHorizon 2025- National Conference on Advancing Frontiers in Computer science and Information Technology,9<sup>th</sup> May 2025 Srinivas University, Mangalore</li>\n \t<li style=\"text-align: justify;\">Presented paper in Anveshana 2025 –Multi disciplinary national Conference ,4<sup>th</sup> april 2025,Sheshadrpuram Degree college,Mysore.</li>\n \t<li style=\"text-align: justify;\">Completed “Machine Learning, ML” MOOC Certificate</li>\n \t<li style=\"text-align: justify;\">Faculty Development Programme “Advanced AI and ML Techniques for Cyber Security and Digital Forensics (2nd September – 12th September 2024), KLE Institute of Technology,Hubballi</li>\n \t<li style=\"text-align: justify;\">Presented paper in TechHorizon 2024- National Conference on Advancing Frontiers in Computer science and Information Technology,29th June 2024 Srinivas University, Mangalore</li>\n \t<li style=\"text-align: justify;\">Completed the Research Methodology course Doing Doctoral-Level Research (DDLR) held from January 2024 to July 2024</li>\n \t<li style=\"text-align: justify;\">Reviewer in IEEE Mysurucon 2024 - 4th Edition of Flagship International Conference of IEEE Mysore Subsection in association with IEEE Bangalore Section hosted by Vidya Vikas Institute of Engineering &amp; Technology, Mysuru on 30th and 31st August 2024</li>\n \t<li style=\"text-align: justify;\">Completed “Research Methodology” MOOC Certificate</li>\n \t<li style=\"text-align: justify;\">Reviewer in the conferences 2023 IEEE Technology and Engineering Management Society Conference: Asia-Pacific ,Reva University , Bnagalore</li>\n \t<li style=\"text-align: justify;\">2023 IEEE THIRD INTERNATIONAL CONFERENCE ON TECHNOLOGY, ENGINEERING, MANAGEMENT FOR SOCIETAL IMAPCT USING MARKETING, ENTREPRENEURSHIP AND TALENT, Mysore.</li>\n</ol>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB; mso-bidi-font-weight: bold;\"><strong>Patent</strong></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: justify;\">1.INTELLIGENT LYMPHEDEMA MANAGEMENT SMART COMPRESSION GARMENTS ENHANCED WITH IOT SENSORS AND MACHINE LEARNING- 202541013740</p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">Roles and Responsibilities: </span></strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB; mso-bidi-font-weight: bold;\">Institute Level</span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">SC-St Committee</li>\n \t<li style=\"text-align: left;\">Students Welfare &amp; Disciplinary Committee</li>\n \t<li style=\"text-align: left;\">Library Committee</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">Roles and Responsibilities: Department</span></strong> <strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB; mso-bidi-font-weight: bold;\">Level</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">EMS Coordinator</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n&nbsp;",
