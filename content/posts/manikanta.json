  "content": "<table width=\"100%\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></p>\n</td>\n</tr>\n<tr>\n<td>\n<table class=\"table-responsive\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><a href=\"https://old.atme.edu.in/?attachment_id=21323\"><img class=\"aligncenter wp-image-21323 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2024/11/Manikanta.jpg\" alt=\"\" width=\"150\" height=\"200\"></a></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Manikanta</strong>\n<strong>Designation: Assistant Professor</strong>\n<strong>Program: Master of Computer Applications</strong>\n<strong>Professional Experience:&nbsp;</strong></p>\n\n<table class=\"table-responsive table\">\n<tbody>\n<tr>\n<td style=\"text-align: center;\" width=\"158\"><strong>Teaching: 2 years</strong></td>\n<td style=\"text-align: center;\" width=\"184\"><strong>Research: 1 year</strong></td>\n<td style=\"text-align: center;\" width=\"168\"><strong>Industry: 6 months</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table class=\"table-responsive\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\">Email ID</td>\n<td style=\"text-align: left;\">Official: <a href=\"mailto:manikanta.mca@old.atme.edu.in\">manikanta.mca@old.atme.edu.in</a></td>\n<td style=\"text-align: left;\">Personal: <a href=\"mailto:manikantaganesh1999@gmail.com\">manikantaganesh1999@gmail.com</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\">Vidwan ID</p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://vidwan.inflibnet.ac.in/profile/582633\">https://vidwan.inflibnet.ac.in/profile/582633</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\">Google Scholar ID</p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://scholar.google.co.in/citations?hl=en&amp;user=MmzgidMAAAAJ\">https://scholar.google.co.in/citations?hl=en&amp;user=MmzgidMAAAAJ</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\">Scopus ID</p>\n</td>\n<td colspan=\"2\"><a href=\"https://id.elsevier.com/settings/redirect?code=AjDE7U2G3ZrP7uED3Au25MuwL6ZlCKBKquAzvw7B\">https://id.elsevier.com/settings/redirect?code=AjDE7U2G3ZrP7uED3Au25MuwL6ZlCKBKquAzvw7B</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\">Orcid ID</p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://orcid.org/0009-0007-0771-7919\">https://orcid.org/0009-0007-0771-7919</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\">Web of Science Researcher ID</p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://www.webofscience.com/wos/author/record/LSL-5704-2024\">https://www.webofscience.com/wos/author/record/LSL-5704-2024</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\">LinkedIn ID</p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://www.linkedin.com/in/manikanta-51626b226/\">https://www.linkedin.com/in/manikanta-51626b226/</a></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<h4 class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration-line: underline; color: #333399;\"><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></span></h4>\n<ul>\n \t<li style=\"text-align: left;\">Ph.D in Applied Sciences (Computer Applications) (Pursuing)</li>\n \t<li style=\"text-align: left;\">Master of Computer Application</li>\n \t<li style=\"text-align: left;\">Bachelor of Computer Application</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\">Areas of Interest</span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">\n<ol>\n \t<li>Artificial intteligence</li>\n \t<li>Cyber security</li>\n \t<li>Cloud computing</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\">Publication Details</span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Machine learning approaches for predicting protein- protein interaction and complexes</li>\n \t<li style=\"text-align: justify;\">Participated in ICRTSTM 2025 and presented a paper on CNN-Based Thermal Signature Analysis.\n<strong>Date &amp; Organized by</strong>: June 2025; organized by Bulletin for Technology and History (UGC Care Group-II Journal).\n<strong>Publication</strong>: Published a paper on AI-Based Predictive Modeling for Microplastic Pollution in BTH, Vol. 25, Issue 6, June 2025 (ID: BTH/3354).</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\">Honours/Awards/ Achievements</span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li>Cyber Security: Simplilearn certification (Oct 2023)</li>\n \t<li>Outcome-Based Education: IPSR Solutions Ltd (Aug 2023)</li>\n \t<li>Python and Machine Learning: Besant Technologies (Jun 2023)</li>\n \t<li>Machine Learning and Creative Thinking: VTU Mysore in association with the Department of Mechanical Engineering (Jul 2022)</li>\n \t<li>Professional Skills Development: TCS iON (Career Edge - Young Professional, June 2021)</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Participated in the National Conference on Emerging Trends in Science &amp; Technology for Ecological Conservation (ETSTEC-2025) on 15th February 2025 and presented a paper titled “Development of an AI-Based Predictive Modelling System for Microplastic Pollution: Analyzing Pollution Sources &amp; Environmental Mitigation Strategies,” organized by Surana College, Bengaluru in association with KSTA</li>\n \t<li style=\"text-align: justify;\">Participated in the Second International Conference on Recent Trends in Science, Technology and Management (ICRTSTM 2025) on 30th June and 1st July 2025, and presented a paper titled “A Comprehensive Review of CNN-Based Thermal Signature Analysis for Advancements in Personalized Health Monitoring.</li>\n \t<li style=\"text-align: justify;\">Presented a paper titled “Future-Gen Health Assistant: Forecast and Communicate with Physics” at ATME College of Engineering, Mysore.</li>\n \t<li style=\"text-align: justify;\">Three days national level fdp on indian knowledge system</li>\n \t<li style=\"text-align: justify;\">Three days national level fdp on UNLOCKING GENRATIVE AI</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: justify;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: left;\">Industrial Visit Coordinator</p>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: justify;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">EMS COORDINATOR</li>\n \t<li style=\"text-align: left;\">PROJECT COORDINATOR</li>\n \t<li style=\"text-align: left;\">RESULT ANALYSIS COORDINATOR</li>\n \t<li style=\"text-align: left;\">CLASS TEACHER</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
