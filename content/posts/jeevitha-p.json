  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-28244 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/04/Ms.-Jeevitha-P-1.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Ms. Jeevitha P</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Master of Business Administration</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 1 year</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching: 1 year</strong></td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research: 0</strong></td>\n<td width=\"168\">\n<p style=\"text-align: left;\"><strong>Industry: 0 years</strong></p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Email ID</strong></p>\n</td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Official: <a href=\"mailto:jeevitha.mba@old.atme.edu.in\">jeevitha.mba@old.atme.edu.in</a></strong></td>\n<td width=\"286\">\n<p style=\"text-align: left;\"><strong>Personal: <a href=\"mailto:jeevithaprakash24@gmail.com\">jeevithaprakash24@gmail.com</a></strong></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Vidwan ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://vidwan.inflibnet.ac.in/profile/630950\">https://vidwan.inflibnet.ac.in/profile/630950</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Google Scholar ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://scholar.google.com/citations?user=jGGdYYYAAAAJ&amp;hl=en\">https://scholar.google.com/citations?user=jGGdYYYAAAAJ&amp;hl=en</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Scopus ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Orcid ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://orcid.org/0009-0005-6374-0289\">https://orcid.org/0009-0005-6374-0289</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Web of Science Researcher ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>LinkedIn ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://www.linkedin.com/in/jeevitha-p-36b709336\">https://www.linkedin.com/in/jeevitha-p-36b709336</a></p>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li>Master of Commerce [ Financial Services] from Manasagangotri, University of Mysore, Mysuru</li>\n \t<li>KSET from KEA in 2024</li>\n \t<li>Bachelor of Commerce from St.Joseph;s First Grade College, University of Mysore, Mysuru</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">\n<ul>\n \t<li>Financial management</li>\n \t<li>Financial services</li>\n \t<li>International Finance</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul class=\"ul1\">\n \t<li class=\"li1\">Mr. Sumuk R, Ms. Druthi I D, Ms. Jeevitha P (2026).Ethical and Efficient Recruitment: The Role of Artificial Intelligence in Reducing Bias and Enhancing Talent Acquisition Decisions. International Journal For Multidisciplinary Research. (IF: 9.24) E-ISSN: 2582-2160/https://www.ijfmr.com/research-paper.php?id=67390</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\">\n<p class=\"p1\"><span style=\"color: #ffffff;\"><b>Honours/Awards/</b><b> </b><b>Achievements</b></span></p>\n</td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"p1\" style=\"text-align: justify;\">Spirited Josephite Award, Presented by St Joseph’s First Grade College, Jayalakshmi Puram Mysuru in recognition of enthusiastic involvement in college activities (2021-22)</p>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li class=\"p1\" style=\"text-align: justify;\">“One week Faculty Development Program on “Enhancing Inclusive Workspaces: Integrating Gender Sensitivity and Cyber Hygiene in Academia” Organized by <span class=\"Apple-converted-space\">&nbsp; </span>Institute of Technology and Management, Gwalior, Madhya Pradesh from 17th June to 23rd June 2025.</li>\n \t<li class=\"p1\" style=\"text-align: justify;\">Five – Days National Level Online FDP on “ICT Tools and Binary Accreditation for Modern Higher Education Institutions” by St Joseph’s First Grade College, Jayalakshmi Puram Mysuru from 23rd June to 27th June 2025.</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Proposal/Funding/Project Financial Assistance</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Patent</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
