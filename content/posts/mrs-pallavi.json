  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-28242 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/04/Mrs.-Pallavi-1.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Mrs. Pallavi</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Master of Business Administration</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 0.8 year</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching: 0.8 year</strong></td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research: 0</strong></td>\n<td width=\"168\">\n<p style=\"text-align: left;\"><strong>Industry: 0 years</strong></p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Official: <a href=\"mailto:pallavi.mba@old.atme.edu.in\">pallavi.mba@old.atme.edu.in</a></strong></td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Personal: <a href=\"mailto:pallaviraju827@gmail.com\">pallaviraju827@gmail.com</a></strong></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Vidwan ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"https://vidwan.inflibnet.ac.in/profile/631036\">https://vidwan.inflibnet.ac.in/profile/631036</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Google Scholar ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"https://scholar.google.com/citations?view_op=new_articles&amp;hl=en&amp;imq=Pallavi+raju#\">https://scholar.google.com/citations?view_op=new_articles&amp;hl=en&amp;imq=Pallavi+raju#</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Scopus ID</strong></td>\n<td colspan=\"2\" width=\"572\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Orcid ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"https://orcid.org/0009-0005-2363-5273\">https://orcid.org/0009-0005-2363-5273</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Web of Science Researcher ID</strong></td>\n<td colspan=\"2\" width=\"572\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>LinkedIn ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"https://www.linkedin.com/in/pallavi-raju-9b05b9253\">https://www.linkedin.com/in/pallavi-raju-9b05b9253</a></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>Master of Business Administration (finance and HR)</strong></li>\n \t<li style=\"text-align: left;\"><strong>Bachelor of Engineering (Civil)</strong></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">\n<ol>\n \t<li>Human Resource Management</li>\n \t<li>Performance Management</li>\n \t<li>Management of Industrial Relations</li>\n \t<li>Managerial Economics and Financial Analysis</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\">\n<p class=\"p1\"><span style=\"color: #ffffff;\"><b>Honours/Awards/</b><b> </b><b>Achievements</b></span></p>\n</td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol class=\"ol1\">\n \t<li class=\"li1\" style=\"text-align: justify;\">Successfully Completed NPTEL Online Certification Course on “Strategic Management- The Competitive Edge” during Aug-Oct 2025.</li>\n \t<li class=\"li2\" style=\"text-align: justify;\">Certificate of Completion – CPD-Certified Leadership &amp; Management Course, Nov 7, 2025.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol class=\"ol1\">\n \t<li class=\"li1\" style=\"text-align: justify;\">Participated in 1-Day International Level FDP on “Growing Globally Competitive Currency in Higher education”, delivered by Futred Innovation Studios, Australia, at ATME College of Engineering, 8<span class=\"s1\"><sup>th</sup></span> October 2025.</li>\n \t<li class=\"li2\" style=\"text-align: justify;\"><span class=\"s2\">Participated i</span>n 5 Days National Level Online FDP on “Applied Research Techniques- A Pragmatic Approach”, organized by the Research and Development Cell, Jain College, 13<span class=\"s3\"><sup>th </sup></span>- 17<span class=\"s3\"><sup>th</sup></span> October 2025.</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">Participated and successfully completed the Faculty Development Program on “Strategic Management- The Competitive Edge” from NPTEL-AICTE during Aug-Oct 2025.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Proposal/Funding/Project Financial Assistance</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\">\n<p class=\"p1\"><span style=\"color: #ffffff;\"><b>Roles and Responsibilities: Department Level</b></span></p>\n</td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol class=\"ol1\">\n \t<li class=\"li1\" style=\"text-align: justify;\">Website Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">Attendance Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">Filing &amp; Documentation Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">Student Activities/ Important Days Celebration Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">NIRF Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">I Year 2025-26 MBA Class Coordinator</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
