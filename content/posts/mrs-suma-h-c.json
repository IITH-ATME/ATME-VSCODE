  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-27714 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/03/Suma-H-C-1.jpg.jpeg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<table>\n<tbody>\n<tr>\n<td colspan=\"3\" width=\"515\">\n<p style=\"text-align: left;\"><strong>Faculty Name: Suma H C </strong></p>\n<p style=\"text-align: left;\"><strong>Designation:</strong><strong>Assistant Professor </strong></p>\n<p style=\"text-align: left;\"><strong>Program:</strong><strong>CSE-AI&amp;ML</strong></p>\n<p style=\"text-align: left;\"><strong>ProfessionalExperience: 6Years</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td width=\"161\"><strong>Teaching:6 </strong>Years</td>\n<td width=\"184\"><strong>Research:1</strong>Year</td>\n<td width=\"170\"><strong>Industry:1Y</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: