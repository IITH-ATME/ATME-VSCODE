  "content": "<div style=\"border: 2px solid black; padding: 10px; font-family: Arial, sans-serif; font-size: 16px;\">\n\n<!-- Header -->\n<div style=\"border: 2px solid black; padding: 10px; font-family: Arial, sans-serif; font-size: 16px;\">\n\n<!-- Heading -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold;\">Technical Staff Profile</div>\n<!-- Faculty Profile: Two Columns -->\n<table style=\"width: 100%; border: 2px solid black; border-collapse: collapse; margin-top: 10px;\">\n<tbody>\n<tr><!-- Photo Placeholder -->\n<td style=\"border: 2px solid black; width: 30%; text-align: center; padding: 10px;\"><img class=\"aligncenter size-large wp-image-23997\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/12/kush-683x1024.png\" alt=\"\" width=\"683\" height=\"1024\"></td>\n<!-- Details -->\n<td style=\"border: 2px solid black; width: 70%; padding: 10px;\">\n<p style=\"text-align: left;\"><strong>Faculty Name:</strong> Kushal R</p>\n<p style=\"text-align: left;\"><strong>Designation:</strong> Instructor</p>\n<p style=\"text-align: left;\"><strong>Program:</strong> Electrical and Electronics Engineering</p>\n<p style=\"text-align: left;\"><strong>Professional Experience:</strong> 14 years</p>\n<p style=\"text-align: left;\"><strong>Date of Joining:</strong> 21.08.2013</p>\n<p style=\"text-align: left;\"><strong>Academic:</strong> 12 years</p>\n<p style=\"text-align: left;\"><strong>Industry:</strong> 2 years</p>\n<p style=\"text-align: left;\"><strong>Email ID:</strong></p>\n<p style=\"text-align: left;\"><strong>Official:</strong><a href=\"mailto:Kushalr_ee@old.atme.edu.in\"> Kushalr_ee@old.atme.edu.in</a></p>\n<p style=\"text-align: left;\"><strong>Personal:</strong> <a href=\"mailto:Kushalraj143@gmail.com\">Kushalraj143@gmail.com</a></p>\n</td>\n</tr>\n</tbody>\n</table>\n<!-- Academic Details -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold; margin-top: 20px;\">Academic Details</div>\n<table style=\"width: 100%; border: 2px solid black; border-collapse: collapse;\">\n<tbody>\n<tr>\n<td style=\"border: 2px solid black; padding: 8px;\">Diploma in Electrical &amp; Electronics Engineering</td>\n</tr>\n</tbody>\n</table>\n</div>\n<!-- Honours/Awards -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold; margin-top: 20px;\">Honours/Awards/ Achievements</div>\n<table style=\"width: 100%; border: 2px solid black; border-collapse: collapse;\">\n<tbody>\n<tr>\n<td style=\"border: 2px solid black; padding: 8px; text-align: left;\">Best non-teaching staff award for the year 2022-23</td>\n</tr>\n</tbody>\n</table>\n<!-- Certifications -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold; margin-top: 20px;\">Workshops/STTP/MOOC Certification</div>\n<table style=\"width: 100%; border: 2px solid black; border-collapse: collapse;\">\n<tbody>\n<tr>\n<td style=\"border: 2px solid black; padding: 8px; text-align: left;\">Successfully Completed 4 Credit MOOC Course on Electricity &amp; Safety measures in proctored examination held on 14.12.2024 offered by IGNOU, New Delhi</td>\n</tr>\n</tbody>\n</table>\n<!-- Responsibilities: Institute -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold; margin-top: 20px;\">Roles and Responsibilities: Institute Level</div>\n<table style=\"width: 100%; border: 2px solid black; border-collapse: collapse;\">\n<tbody>\n<tr>\n<td style=\"border: 2px solid black; padding: 8px;\">\n<ul>\n \t<li style=\"text-align: left;\">Maintenance of UPS in the campus</li>\n \t<li style=\"text-align: left;\">Maintenance of Diesel Generator Set 100KVA</li>\n \t<li style=\"text-align: left;\">Maintenance of Solar Power Plant 100KW</li>\n \t<li style=\"text-align: left;\">Additional Responsibility as assistant to Transportation section</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<!-- Responsibilities: Department -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold; margin-top: 20px;\">Roles and Responsibilities: Department Level</div>\n<table style=\"width: 100%; border: 2px solid black; border-collapse: collapse;\">\n<tbody>\n<tr>\n<td style=\"border: 2px solid black; padding: 8px;\">\n<ul>\n \t<li style=\"text-align: left;\">Responsibility given as Lab Instructor for the lab Courses</li>\n \t<li style=\"text-align: left;\">Department Co-Curricular Activities for students</li>\n \t<li style=\"text-align: left;\">Assisting in Accreditation/Certification works like (NIRF,NBA,NAAC,ISO etc)</li>\n \t<li style=\"text-align: left;\">Electric Meter Reading</li>\n \t<li style=\"text-align: left;\">Maintenance of Department servers</li>\n \t<li style=\"text-align: left;\">Maintenance of Department seminar hall</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n</div>",
