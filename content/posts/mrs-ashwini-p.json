  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-28501 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/05/Ashwini-P.jpg\" alt=\"\" width=\"170\" height=\"260\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Ashwini P</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Computer Science and Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 10</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: center;\" width=\"158\"><strong>Teaching: 10 Years</strong></td>\n<td style=\"text-align: center;\" width=\"184\"><strong>Research:</strong></td>\n<td style=\"text-align: center;\" width=\"168\"><strong>Industry: Nil</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\"><strong>Official: <a href=\"mailto:ashwinip.cs@old.atme.edu.in\">ashwinip.cs@old.atme.edu.in</a></strong></td>\n<td style=\"text-align: left;\"><strong>Personal: <a href=\"mailto:ashwini9986@gmail.com\">ashwini9986@gmail.com</a></strong></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Vidwan ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">553439</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Google Scholar ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://scholar.google.com/citations?hl=en&amp;view_op=list_works&amp;authuser=1&amp;gmla=AH8HC4ypGy8K0vRdF2YT6NZa5sThiCCV8PR8bWtwf9CFYgEpKxtvT3nzw1-6Ajp76fL2bkmKueuWvW-7pZIYgw&amp;user=sKBH-S0AAAAJ\">https://scholar.google.com/citations?hl=en&amp;view_op=list_works&amp;authuser=1&amp;gmla=AH8HC4ypGy8K0vRdF2YT6NZa5sThiCCV8PR8bWtwf9CFYgEpKxtvT3nzw1-6Ajp76fL2bkmKueuWvW-7pZIYgw&amp;user=sKBH-S0AAAAJ</a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Scopus ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Orcid ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>Web of Science</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><strong>LinkedIn ID</strong></p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>M. Tech</strong> in Computer Science and Engineering</li>\n \t<li style=\"text-align: left;\"><strong>B.E</strong> in Information Science and Engineering</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">Image Processing</li>\n \t<li style=\"text-align: left;\">IOT</li>\n \t<li style=\"text-align: left;\">Machine Learning</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Published “<strong>Iot Based Prediction Of Land Degradation</strong>” in IJCRT Volume 13 Issue 3 March 2025, ISSN:2320-2882.</li>\n \t<li style=\"text-align: justify;\">Published <strong>“Smart Voting System Using Machine Learning” </strong>in IJCRT Volume 13 Issue 3 March 2025, ISSN:2320-2882.</li>\n \t<li style=\"text-align: justify;\">Published <strong>“Prediction and analysis of Stock Market using LSTM and Machine learning</strong>” in International Research Journal of engineering and technology (IRJET), Volume 11 issue 04, April 2024.</li>\n \t<li style=\"text-align: justify;\">Published “<strong>IoT based Milk Adulteration detection and Identification of A and A2 milk</strong>” in International Research Journal of engineering and technology (IRJET), Volume 11 issue 04, April 2024.</li>\n \t<li style=\"text-align: justify;\">Presented the paper “Content Based Image Retrieval System for Multi Object Images using Combined Features” in National Conference on Recent Trends in Computers, Communication &amp; Information Technology in Dr.T.Thimmaiah institute of technology, K.G.F.</li>\n \t<li style=\"text-align: justify;\">Presented the paper “Framework for testing Database application &amp; testing transactions with agenda“in ADVAYA-09 a National Level Technical Symposium in Shiridi sai Engineering College, Anekal, Bangalore.</li>\n \t<li style=\"text-align: justify;\">Published and Presented” Driver Drowsiness Detection System in Automotive Vehicles” in International Journal of Engineering Research &amp; Technology (IJERT) ISSN: 2278-0181 Published by, <a href=\"http://www.ijert.org/\">ijert.org</a> NCETEIT - 2017 Conference Proceedings.</li>\n \t<li style=\"text-align: justify;\">Published “Image Retrieval Using Shot Boundary Detection and Key Frame Extraction Based Technique for Video Summarization” at IJRCM in the year 2015.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\"><strong>MEMBERSHIP IN PROFESSIONAL BODIES</strong></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">Institute of Engineers. India.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\"><strong>HONOURS/AWARDS/</strong><strong> ACHIEVEMENTS</strong></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">&nbsp;</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">One week National Level FDP on <strong>“DEVOPS and Gen AI”</strong>Organized by JSSETW, Bangalore<strong>, from 03<sup>rd</sup> Feb 2025 to &nbsp;07<sup>th</sup> Feb 2025 &nbsp;</strong>and obtained A+ grade<strong>.</strong></li>\n \t<li style=\"text-align: left;\">Six days online National Level FDP on <strong>“DEVOPS” </strong>Organized by VVCE,Mysore<strong>, from 4<sup>th</sup> Nov 2024 to 09<sup>th</sup> Nov 2024 &nbsp;</strong>and obtained A+ grade<strong>.</strong></li>\n \t<li style=\"text-align: left;\"><strong>Three Day workshop on “patent Drafting , filing and Interpretation” organized by ATME college of Engineering on 12<sup>th</sup> to 14<sup>th</sup> June 2025.</strong></li>\n \t<li style=\"text-align: left;\">Six days National Level FDP on <strong>“Advanced DevOps “ </strong>Organized by MRIT, Mysore<strong>, from 21<sup>st</sup> July to 26<sup>th</sup> July 2025.</strong></li>\n \t<li style=\"text-align: left;\">Ten days National level FDP on <strong>“Cyber security and block chain” </strong>organized by Vidyavardhaka College of Engineering, Mysore from 19<sup>th</sup> February 2024 to 29<sup>th</sup> February 2024.</li>\n \t<li style=\"text-align: left;\">One week National Level FDP on <strong>ADVANCED PEDAGOGICAL TECHNIQUES </strong>Organized by Teaching Learning Centre <strong>Ramanujan College, University of Delhi, from 16<sup>th</sup> January 2024 to 22<sup>th</sup> January 2024 </strong>and obtained A+ grade<strong>.</strong></li>\n \t<li style=\"text-align: left;\">One week National Level FDP on <strong>Cloud Infrastructure(AWS) </strong>organized by The National Institute of Engineering , Mysore, Karnataka from 21 August,2023-25<sup>th</sup> August, 2023.</li>\n \t<li style=\"text-align: left;\"><strong>Presented in IEEE conference on “Personalized workout and Diet Planner with FitBit smart watch” in IEEE Mysurucon 2024- 4<sup>th</sup> edition .</strong></li>\n \t<li style=\"text-align: left;\"><strong>Presented in AICDMB-2025 on “integrated ” Web based Augmented Reality and AI for Immersive Booking Experience “ Organised by VVCE on&nbsp; 27<sup>th</sup> and 28<sup>th</sup> June 2025.</strong></li>\n \t<li style=\"text-align: left;\"><strong>Completed MOOC courses from INFOSYS Spring Board :</strong></li>\n</ol>\n<ul style=\"text-align: left;\">\n \t<li><strong>Introduction to agile Technology </strong></li>\n \t<li><strong>Software Engineering and Agile Software Development</strong></li>\n \t<li><strong>Agile Scrum in Practice.</strong></li>\n \t<li><strong>Software Engineering and ALM</strong></li>\n \t<li><strong>Continues Integration and Delivery -DevOps</strong></li>\n</ul>\n<ol style=\"text-align: left;\">\n \t<li><strong>Completed MOOC course From Udemy:</strong></li>\n</ol>\n<ul>\n \t<li style=\"text-align: left;\"><strong>Patent Filing in India.</strong></li>\n \t<li style=\"text-align: left;\"><strong>DevOps Beginners to Advanced Project</strong></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>PROPOSAL/FUNDING/PROJECT FINANCIAL ASSISTANCE</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>“IoT based Milk Adulteration detection and Identification of A and A2 milk” Has approved by KSCST for funding (5000rs) in the year 2023-2024.</li>\n \t<li>“Driver Drowsiness Detection system” in the year 2017 funded by KSCST and selected to final project exhibition.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>PATENT</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">-</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Admission Section Coordinator</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>New Letter Coordinator</li>\n \t<li>Academic Coordinator</li>\n \t<li>Criteria 5 Coordinator</li>\n \t<li>Class Teacher</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>",
