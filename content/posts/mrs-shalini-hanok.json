  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-24695 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/09/Dr.-Shalini-Hanok-2-1.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Dr. Shalini Hanok</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Associate Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Electronics and Communication Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 9.5 Years</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td width=\"158\"><strong>Teaching:&nbsp; </strong>9.5 Years</td>\n<td width=\"184\"><strong>Research: </strong>5 Years</td>\n<td width=\"168\"><strong>Industry: </strong>Nil</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Email ID</p>\n</td>\n<td width=\"286\">\n<p style=\"text-align: left;\"><strong>Official:<a href=\"mailto:dr.shalinihanok_ec@old.atme.edu.in\">dr.shalinihanok_ec@old.atme.edu.in</a></strong></p>\n</td>\n<td width=\"286\"><strong>Personal:<a href=\"mailto:shalini.prabhakar@gmail.com\">shalini.prabhakar@gmail.com</a></strong></td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Vidwan ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://vidwan.inflibnet.ac.in/profile/294599\">294599</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Google Scholar ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://scholar.google.com/citations?user=qsAtHvgAAAAJ&amp;hl=en\">https://scholar.google.com/citations?user=qsAtHvgAAAAJ&amp;hl=en</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Scopus ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\">58133866900</p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Orcid ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">Web of Science Researcher ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\">LinkedIn ID</p>\n</td>\n<td colspan=\"2\" width=\"573\">\n<p style=\"text-align: left;\"><a href=\"https://www.linkedin.com/in/dr-shalini-hanok-2262a6162/\">https://www.linkedin.com/in/dr-shalini-hanok-2262a6162/</a></p>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>Ph.D. in&nbsp;&nbsp; Network Security</strong></li>\n \t<li style=\"text-align: left;\"><strong>M. Tech</strong> &nbsp;in Digital Electronics and Communication</li>\n \t<li style=\"text-align: left;\"><strong style=\"font-family: inherit; font-size: inherit;\">B.E</strong><span style=\"font-family: inherit; font-size: inherit;\"> in Electronics and Communication</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">\n<ol>\n \t<li>Cybersecurity</li>\n \t<li>Machine Learning</li>\n \t<li>Data science and AI</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\"><strong>Journal Publication:</strong>\n<ol>\n \t<li style=\"text-align: justify;\">Paramesha, K., Jalapur, S., Hanok, S. <em>et al.</em> Machine Learning and Deep Learning Approaches for Guava Disease Detection. <em>SN COMPUT. SCI.</em> <strong>6</strong>, 361 (2025). <a href=\"https://doi.org/10.1007/s42979-025-03886-6\">https://doi.org/10.1007/s42979-025-03886-6</a>.</li>\n \t<li style=\"text-align: justify;\">Shalini Hanok, Navya N, Kavyashree M K, Anupama S <strong>“Statistical Authentication Technique for Facebook using Social Network Analysis” </strong>Journal of Propulsion Technology (Scopus-Q3), December 2023.</li>\n \t<li style=\"text-align: justify;\">Shalini Hanok and Shankaraiah<strong> “In Loco Identity Fraud Detection Model using Statistical Analysis for Social Networking Sites: A case study with Facebook</strong>\"- International Arab Journal of Information Technology (IAJIT) (SCI Expanded Journal, Impact factor - <em>967, Q3</em>), March 2023. doi: 10.34028/iajit/20/2/15.</li>\n \t<li style=\"text-align: justify;\">Shalini P and Shankaraiah<strong> “Multimodal Biometric Decision Fusion Security Technique to Evade Immoral Social Networking Sites for Minor\"--</strong>Applied Intelligence (SCI Journal, Impact factor - 5.086, Q1), May 2022. <a href=\"https://doi.org/10.1007/s10489-022-03538-9\">https://doi.org/10.1007/s10489-022-03538-9</a></li>\n \t<li style=\"text-align: justify;\">Shalini P and Shankaraiah<strong> “Social Behavioral Biometric Multimodal Union to Evade Fake Account Creation in Facebook”</strong>-- Multimedia Tools and communication (SCI Expanded Journal, Impact factor - 2.577, Q1), May 2022. <a href=\"https://doi.org/10.1007/s11042-022-13104-7\">https://doi.org/10.1007/s11042-022-13104-7</a></li>\n</ol>\n<strong>CONFERENCE PAPER:</strong>\n<ol start=\"6\">\n \t<li style=\"text-align: justify;\">Shalini Hanok, Veeraprathap V, and Swetha K T and Simran Pal R “<strong>Unimodal Biometric Authentication System using Social Network Analysis</strong>” International conference on\n‘Next generation devices &amp; smart computing application”\n(ICNGSDSCA-2024) In association with Springer, Cambridge institute of technology, Bangalore, December 2024</li>\n \t<li style=\"text-align: justify;\">Shalini P and Shankaraiah<strong>, “A Novel Technique to regulate access to immoral content for Minors\"-</strong>Accepted and published in IEEE conference on 2019, 7th International Conference on Smart Computing &amp; Communications (ICSCC-2019), <strong>Miri, Sarawak, Malaysia.</strong></li>\n \t<li style=\"text-align: justify;\">Shalini P and Kavyashree M K, “Survey On Various Mac Layer Backoff Algorithms in IEEE 802.15.4” International Conference On Emerging Trends In Science And Engineering(Icetse-2017), Coorg Institute Of Technology, Ponnampet, Kodugu, Karnataka.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><strong><span style=\"color: #ffffff;\">Membership in Professional Bodies</span></strong></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">IEEE membership</li>\n \t<li style=\"text-align: left;\">IAENG membership number is: 391326.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Completed Advanced certification in “<strong>Data Science and AI</strong>” for a duration of <strong>September 2022 to September 2023</strong>, from IIT Madras-Digital Skills Academy’s Programme, Intellipaat Software Solutions Pvt. Ltd.</li>\n \t<li style=\"text-align: justify;\">Symposium on “<strong>Application of image processing techniques in the field of Electronics and Communication and Civil Engineering</strong><strong>” 6<sup>th</sup> to 10<sup>th</sup> November 2023</strong>, ATME College of Engineering, Mysore.</li>\n \t<li style=\"text-align: justify;\">Offline FDP on “<strong>Advanced communication using USRP and LabView</strong>” from <strong>25 th September to 27 th September 2023</strong>, ATME College of Engineering, Mysore.</li>\n \t<li style=\"text-align: justify;\">Offline FDP on “<strong>Inculcating Universal Human Values in Technical Education</strong>” from <strong>7th September to 9th September 2023</strong>, Vidya Vardhaka College of Engineering, Mysore.</li>\n \t<li style=\"text-align: justify;\">Online FDP on “<strong>Outcome Based Education and Essential AI Tools for Teachers</strong>” from <strong>10<sup>th</sup> August to 18<sup>th</sup> August 2023,</strong> organised by the Internal Quaiity Assurance Cell (IQAC) of Carmel College (Autonomous), Mala in association with The Kerala State Higher Education Council (KSHEC).</li>\n \t<li style=\"text-align: justify;\">Workshop on “<strong>Research proposal writing</strong>” by Indian ledge system organized by ICMR, Hyderabad from <strong>17<sup>th</sup> -18<sup>th</sup> February 2023</strong>. Submitted research proposal on 25<sup>th</sup> Feb 2023.</li>\n \t<li style=\"text-align: justify;\">Workshop on <strong>“Research Proposal Preparation</strong><strong>”</strong>, from <strong>5<sup>th</sup> to 6<sup>th</sup> September 2019</strong>, Department of Electronics and Communication Engineering, SJCE, JSS Science and Technology University, JSS TI Campus, Mysuru, Karnataka.</li>\n \t<li style=\"text-align: justify;\">A Tutorials on <strong>“Deriving a Machine Learning Model for Identifying Meteoroids</strong><strong>”,</strong> 28<sup>th</sup> June 2019,<strong> Miri, Sarawak, Malaysia.</strong></li>\n \t<li style=\"text-align: justify;\">Workshop on <strong>“Cybersecurity for Water Management Systems in 21<sup>st</sup> Century</strong><strong>”</strong>, 29<sup>th</sup> June 2019, <strong>Miri, Sarawak, Malaysia.</strong></li>\n \t<li style=\"text-align: justify;\">Workshop on “<strong>Hands on Practice with VISUAL TCAD</strong>”, from <strong>9<sup>th</sup> March to 15<sup>th</sup> March 2019</strong>, Department of Electronics and Communication Engineering, SJCE, JSS Science and Technology University, JSS TI Campus, Mysuru, Karnataka.</li>\n \t<li style=\"text-align: justify;\">Faculty Development Program on <strong>“Cybersecurity, Network Simulators and Research Challenges in Networking</strong><strong>”</strong>, from <strong>21<sup>st</sup> to 25<sup>th</sup> January 2019</strong>, Department of Computer Science &amp; Engineering, Vidyavardhaka College of Engineering, Mysuru, Karnataka.</li>\n \t<li style=\"text-align: justify;\">Workshop on <strong>“Research Methodologies</strong><strong>”</strong>, from <strong>18<sup>th</sup> to 19<sup>th</sup> November 2017</strong>, JSS Science and Technology University, JSS TI Campus, Mysuru, Karnataka.</li>\n \t<li style=\"text-align: justify;\">Offline FDP on <strong style=\"text-align: justify; font-family: inherit; font-size: inherit;\">“Network Simulator-2”,</strong><span style=\"text-align: justify; font-family: inherit; font-size: inherit;\"> from </span><strong style=\"text-align: justify; font-family: inherit; font-size: inherit;\">17<sup>th</sup> to 19<sup>th</sup> August 2017</strong><span style=\"text-align: justify; font-family: inherit; font-size: inherit;\">, Department of Computer Science &amp; Engineering, Vidyavardhaka College of Engineering, Mysuru, Karnataka.</span></li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Honours/Awards/ Achievements</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Indian Excellence Award for “<strong>Best Researcher Award</strong><strong>”</strong> by Jataayu Staffing Force Private Limited, Mysuru on 19th June 2022.</li>\n \t<li style=\"text-align: justify;\">Engineering Consultancy Project “<strong>Social Behavioural Biometric using machine learning for online social network</strong>” project is sponsored by DCSR, Mysuru.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Patent</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: justify;\">Dr. Shalini Hanok and Dr. Shankaraiah “Decision Fusion Techniques for Multimodal Biometric Authentication SYSTEM” APPLICATION No.202341028598, DATED : 5/5/2023</p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Member IIC committee</li>\n \t<li>Cultural Committee</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Research coordinator</li>\n \t<li>MoU file in charge</li>\n \t<li>Internship Coordinator</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>",
