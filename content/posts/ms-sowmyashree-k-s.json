  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-22760 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/09/Mrs.-Sowmyashree-K-S-2.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Sowmyashree K S</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Electrical and Electronics Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 5.5 years</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching: 5.5</strong></td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research:</strong></td>\n<td width=\"168\">\n<p style=\"text-align: left;\"><strong>Industry:</strong></p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Official: <a href=\"mailto:sowmyashreeks_ee@old.atme.edu.in\">sowmyashreeks_ee@old.atme.edu.in</a></strong></td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Personal: <a href=\"mailto:Sowmya.ks95@gmail.com\">Sowmya.ks95@gmail.com</a></strong></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Vidwan ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"https://vidwan.inflibnet.ac.in/profile/235692\">https://vidwan.inflibnet.ac.in/profile/235692</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Google Scholar ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"http://scholar.google.co.in/citations?user=z48eipQAAAAJ\">http://scholar.google.co.in/citations?user=z48eipQAAAAJ</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Scopus ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"http://www.scopus.com/authid/detail.url?authorId=58654107200\">http://www.scopus.com/authid/detail.url?authorId=58654107200</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Orcid ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"http://www.orcid.org/0000-0002-2656-0829\">http://www.orcid.org/0000-0002-2656-0829</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Web of Science Researcher ID</strong></td>\n<td colspan=\"2\" width=\"572\">&nbsp;\n\n&nbsp;</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>LinkedIn ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"572\"><a href=\"https://www.linkedin.com/in/sowmyashree-k-s-718771126/\">https://www.linkedin.com/in/sowmyashree-k-s-718771126/</a></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>M.Tech</strong> in Powe System Engineering</li>\n \t<li style=\"text-align: left;\"><strong style=\"font-family: inherit; font-size: inherit;\">B.E</strong><span style=\"font-family: inherit; font-size: inherit;\"> in Electrical and Electronics Engineering</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: justify;\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">Power System Analysis</li>\n \t<li style=\"text-align: left;\">Electrical Machines</li>\n \t<li style=\"text-align: left;\">Cybersecurity</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Javid Akthar P1, Sowmyashree K S2, <strong>“ Impact of Thyristor Controlled Series Capacitor on Power System Performance”</strong> in the international conference on Future Trends in Electrical and Electronics Engineering (FTEEE) held at Bengaluru.</li>\n \t<li style=\"text-align: justify;\">Dr. Sathish K R, Sowmyashree K S, Shwetha N <strong>“3D Printing Using Recycled Filament” . </strong>Publisher: International Conference on Recent Trends in Science &amp; Technology-2021 (ICRTST - 2021), Volume-8, Special Issue | Oct 2021, e-ISSN: 2395-0056, p-ISSN: 2395-0072.</li>\n \t<li style=\"text-align: justify;\">Gopal Reddy K, Dr. Parthasarathy L, Dr. Shakunthala C, and Sowmyashree K S, “Optimal Placement of Distributed Generation for Power Quality Improvement Using Hybrid ABC-CS Algorithm “, International Conference for Recent Trends in Science and Technology-2022, July 14th &amp; 15th 2022.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Membership in Professional Bodies</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: justify;\">IAENG-International Association of Engineers</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Honours/Awards/ Achievements</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\"></td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">National Initiative for Technical Teachers Training (NITTT) Course Certification of 4 Modules.</li>\n \t<li style=\"text-align: justify;\">Participated one week State Level FDP, a workshop on “Cyber security and Digital Forensics” in Association with the Institute of Engineers from 21st to 25th Aug 2023 organised by Department of Electrical and Electronics Engineering ATMECE Mysuru.</li>\n \t<li style=\"text-align: justify;\">Participated in one week State Level FDP One week online Faculty Development Program On” “Research Methodology” organized by E&amp;ICT Academy IIT Guwahati.</li>\n \t<li style=\"text-align: justify;\">Five days online Faculty Development Program On “Including Universal Human Values in Technical Education” organized by All India Council for Technical Education(AICTE).</li>\n \t<li style=\"text-align: justify;\">Two days Faculty Development Program On “Outcome Based Education and Bloom’s Taxonomy” organized by K.S School of Engineering and Management, Bangalore.</li>\n \t<li style=\"text-align: justify;\">One-day Faculty Development Program On “Training the Trainer Workshop on Intellectual Property Rights Significance of Academia” held at K.S School of Engineering and Management, Bangalore. K.S School of Engineering and Management, Bangalore.</li>\n \t<li style=\"text-align: justify;\">Two-days workshop on “Review of Latest trends in Transformer Design, Manufacture and Cad” conducted by the Department of Electrical and Electronics Engineering. held at K.S School of Engineering and Management, Bangalore. K.S School of Engineering and Management, Bangalore.</li>\n \t<li style=\"text-align: justify;\">One-day Faculty Development Program On “LATEX” organized by the Department of Electronics and Communication Engineering, organised by ATMECE Mysore.</li>\n \t<li style=\"text-align: justify;\">One-day workshop on “Interfacing Innovation and TPR for Diffusion of Technology” organized by NRDC, New Delhi and ATMECE</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Proposal/Funding/Project Financial Assistance</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li>VTU Financial assistance for final year project for AY- 2022-23</li>\n</ul>\n<p style=\"padding-left: 80px;\"><strong>Title:</strong> Design and Fabrication of Solar Power Portable Medical Refrigerator for Remote and Rural areas using Peltier Effect</p>\n<p style=\"padding-left: 80px;\">Amount: Rs. 7000/-</p>\n</td>\n</tr>\n</tbody>\n<tbody style=\"padding-left: 80px;\">\n<tr style=\"height: 22.45pt; text-align: justify; padding-left: 80px;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt 0cm 85px; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Patent</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: justify;\" width=\"363\"><strong>National</strong></td>\n<td style=\"text-align: justify;\" width=\"363\"><strong>International</strong></td>\n</tr>\n<tr style=\"text-align: justify;\">\n<td width=\"363\"><strong>&nbsp;</strong></td>\n<td width=\"363\"><strong>&nbsp;</strong></td>\n</tr>\n<tr>\n<td style=\"text-align: justify;\" width=\"363\"><strong>Title:</strong>\n\n<strong>Published/Granted:</strong>\n\n<strong>Patent No.:&nbsp;</strong>\n\n<strong>&nbsp;</strong></td>\n<td width=\"363\">\n<p style=\"text-align: justify;\"><strong>Title:</strong></p>\n<p style=\"text-align: justify;\"><strong>Published/Granted:&nbsp;</strong></p>\n<p style=\"text-align: justify;\"><strong>Patent No.:&nbsp;</strong></p>\n<strong>&nbsp;</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li>Hostel Committee</li>\n \t<li>Transportation Committee</li>\n</ul>\n</td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: justify;\">IR- Files NBA- Compiling and submitting institute files for NBA</li>\n \t<li style=\"text-align: justify;\">Co-Ordinator: NBA-C3</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>",
