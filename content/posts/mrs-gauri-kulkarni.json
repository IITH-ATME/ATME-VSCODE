  "content": "<!-- wp:paragraph -->\n<p><strong>Mrs. Gouri S Kulkarni</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Assistant Professor</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Education Details</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul><!-- wp:list-item -->\n<li>M.Tech Computer Networking, UVCE, Bangalore University Bangalore.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>B.E, ISE, BEC, Bagalkot, Autonomous (VTU).</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p><strong>Professional Experience</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul><!-- wp:list-item -->\n<li>Teaching Experience – 1 years</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Assistant Professor</strong>, ATME, Mysore June 2023 – Till date</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Assistant Professor</strong>, NIE, Mysuru,&nbsp;September 2021 –&nbsp;August 2022.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p><strong>Industry Experience</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul><!-- wp:list-item -->\n<li><strong>Software Developer</strong>, Siemens Technologies and Services, Bangalore. Nov 2019 – Feb&nbsp; 2021</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Intern</strong>, Siemens Technologies and Services, Bangalore, September 2018 – May 2019</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->",
