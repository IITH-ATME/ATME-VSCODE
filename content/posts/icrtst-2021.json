  "content": "<div class=\"entry-header\">\n<h2 class=\"entry-title event-entry-title course-entry-title\" style=\"text-align: center;\">ICRTST-2021</h2>\n</div>\n<div class=\"entry-blog single-course-content\">\n<div class=\"entry-summary clearfix\">\n<div class=\"container\" style=\"text-align: center;\">\n<div class=\"vc_row wpb_row vc_row-fluid\">\n<div class=\"wpb_column vc_column_container vc_col-sm-12\">\n<div class=\"vc_column-inner \">\n<div class=\"wpb_wrapper\">\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<h3></h3>\n<h3>Join YouTube Live Stream Here: <a href=\"https://youtube.com/c/ATMECEOfficial\">Click Here</a></h3>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container\">\n<div class=\"vc_row wpb_row vc_row-fluid\">\n<div class=\"wpb_column vc_column_container vc_col-sm-12\">\n<div class=\"vc_column-inner \">\n<div class=\"wpb_wrapper\">\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p style=\"text-align: center;\"><strong>Conference date:</strong> 8th and 9th July 2021</p>\n<p style=\"text-align: center;\"><strong>Date of Inauguration : </strong>8th July 2021, 10 AM</p>\n<p style=\"text-align: center;\"><strong>Chief Guest: </strong>Er. Narendra Singh, FIE</p>\n<p style=\"text-align: center;\"><strong>President  –  </strong>IE(I), Kolkata</p>\n<p style=\"text-align: center;\"><strong>Guest of Honour :  </strong>Dr. A S Deshpande</p>\n<p style=\"text-align: center;\">Registrar, Visvesvaraya Technical University, Belagavi</p>\n<p style=\"text-align: center;\"><strong>Guest of Honour : </strong> Er. Jasmail Singh, FIE, FIWWA</p>\n<p style=\"text-align: center;\">Chairman, IE(I), Karnataka State Centre</p>\n<p style=\"text-align: center;\"><strong>Presided by </strong></p>\n<p style=\"text-align: center;\"><strong>Sri L Arun Kumar</strong></p>\n<p style=\"text-align: center;\"><strong>Hon’ble Chairman</strong></p>\n<p style=\"text-align: center;\"><strong>ATMECE, Mysuru</strong></p>\n<p style=\"text-align: center;\"><strong>Patrons</strong></p>\n<p style=\"text-align: center;\"><strong>Sri K. Shivashanakar</strong></p>\n<p style=\"text-align: center;\"><strong>Hon’ble Secretary</strong></p>\n<p style=\"text-align: center;\"><strong>ATMECE, Mysuru</strong></p>\n<p style=\"text-align: center;\"><strong>Sri R. Veeresh</strong></p>\n<p style=\"text-align: center;\"><strong>Hon’ble Treasurer</strong></p>\n<p style=\"text-align: center;\"><strong>ATMECE, Mysuru</strong></p>\n<p style=\"text-align: center;\"><strong>Key Note Speakers:</strong></p>\n<p style=\"text-align: center;\"><strong>Dr. Mohd Helmy ABD Wahab</strong></p>\n<p style=\"text-align: center;\"><strong>UNIVERSITI  TUN  HUSSEN ONN, MALAYSIA</strong></p>\n<p style=\"text-align: center;\"><strong>Dr. H P Kincha</strong></p>\n<p style=\"text-align: center;\"><strong>Former Vice Chancellor,</strong></p>\n<p style=\"text-align: center;\"><strong>Visvesvaraya Technological University, Belagavi, INDIA</strong></p>\n<p style=\"text-align: center;\"><strong>Dr. Basavaraj L</strong></p>\n<p style=\"text-align: center;\"><strong>Principal</strong></p>\n<p style=\"text-align: center;\"><strong>ATMECE, Mysuru</strong></p>\n<p style=\"text-align: center;\"><strong>Dr. Parthasarathy L</strong></p>\n<p style=\"text-align: center;\"><strong>Organizing Chair, Professor &amp; Head</strong></p>\n<p style=\"text-align: center;\"><strong>Dept. of EEE, ATMECE, Mysuru</strong></p>\n<p style=\"text-align: center;\"><strong>Venue: Auditorium, ATMECE, MYSURU</strong></p>\n<p style=\"text-align: center;\"><strong>Date of Valedictory : 9th July 2021, 3.30 PM</strong></p>\n<p style=\"text-align: center;\"><strong>Chief Guest: Dr. Shyam Vasudev Rao</strong></p>\n<p style=\"text-align: center;\"><strong>Director, Forus Health Pvt. Ltd,</strong></p>\n<p style=\"text-align: center;\"><strong>Bengaluru</strong></p>\n<p style=\"text-align: center;\"><strong>Guest of Honour :  Mr. Harsha B Y</s