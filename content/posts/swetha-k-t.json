  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-24498 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2025/08/Mrs.-Swetha-K-T-2.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: <span style=\"text-decoration: underline; color: #333399;\">Swetha K T </span></strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Electronics &amp; Communication Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 08</strong></p>\n\n<table class=\" alignleft\">\n<tbody>\n<tr>\n<td width=\"158\"><strong>Teaching: 08</strong></td>\n<td width=\"184\"><strong>Research: Nil</strong></td>\n<td width=\"168\"><strong>Industry: Nil</strong></td>\n</tr>\n</tbody>\n</table>\n<p style=\"text-align: left;\">&nbsp;</p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\" width=\"36%\"><strong>Official:&nbsp;</strong></td>\n<td style=\"text-align: left;\" width=\"38%\"><strong>Personal:</strong> <a href=\"mailto:2007.swetha@gmail.com\"><strong>2007.swetha@gmail.com</strong></a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Vidwan ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\">-</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Google Scholar ID-</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\">-</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Scopus ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\">-</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Orcid ID-</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\">-</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Web of Science Researcher ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\">-</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>LinkedIn ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\"><b>-</b></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<h3 class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration-line: underline; color: #333399;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></strong></span></h3>\n<ul>\n \t<li style=\"text-align: left;\"><strong>M.Tech.</strong> in Digital Electronics &amp; Communication Systems</li>\n \t<li style=\"text-align: left;\"><strong>MBA</strong> (HRM Specialization)</li>\n \t<li style=\"text-align: left;\"><strong>PG Diploma</strong> in HRM</li>\n \t<li style=\"text-align: left;\"><strong>B.E</strong> in Electronics &amp; Communication Engineering</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Membership in Professional Bodies</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">ISTE</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 2; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Research Areas of Interest</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 3; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">Signals &amp; Systems, Digital Electronics, Digital Communication, Electromagnetic Waves</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 4; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><span style=\"color: #ffffff;\"><strong><span style=\"font-size: 18px;\">Publications Details</span></strong></span></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 5; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: justify;\"><strong>International Journals</strong></p>\n\n<ol style=\"text-align: justify;\">\n \t<li>“Performance Analysis of Different ANN Structures in Classifying Brain MRI Images for Various Training Data”, International Journal of Scientific Research and Education, ISSN: 2321-7545, Vol. 2, Issue 5, 2014, pp. 836-</li>\n \t<li>“Investigation of the Effect of Training Data on the Performance of Support Vector Machine in Classification of Brain MR Images”, International Journal of Emerging Trends in Science and Technology, ISSN: 2348-9480, 1, Issue 4, June 2014, pp.417-421.</li>\n \t<li>“Career Planning and Development at Bajaj Allianz Life Insurance Company Limited, Mysore – A Case Study”, Midas Touch International Journal of Commerce, Management and Technology, ISSN: 2320-7787, Vol. 2, No. 1, January 2014, pp. 320-</li>\n \t<li>“Implementation of Coded OFDM Using AWGN and Rayleigh Noise”, Midas Touch International Journal of Commerce, Management and Technology, ISSN: 2320-7787, 2, No. 1, January</li>\n</ol>\n<p style=\"padding-left: 80px; text-align: justify;\"><strong>a.</strong> 2014, pp. 129-135.</p>\n\n<ol style=\"text-align: justify;\">\n \t<li style=\"list-style-type: none;\">&nbsp;</li>\n</ol>\n<p style=\"text-align: justify;\"><strong>International Conferences:</strong></p>\n\n<ol>\n \t<li style=\"text-align: justify;\">“Implementation of Coded OFDM Using AWGN and Rayleigh Noise”, International Conference on Technology Management for Green Environment (ICTMGE -2013), Visvesvaraya Technological University-Regional College, Mysore, 19th - 21st September</li>\n \t<li style=\"text-align: justify;\">“Career Planning and Development at Bajaj Allianz Life Insurance Company Limited, Mysore – A Case Study”, International Conference on Technology Management for Green Environment (ICTMGE-2013), Visvesvaraya Technological University-Regional College, Mysore, 19th-21st September 2013.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">Honours/Awards/ Achievements</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">Best Teacher Award</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">Roles and Responsibilities: Institute Level</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">Member of Test Committee</li>\n \t<li style=\"text-align: left;\">Member of International Conference Coordination Committee</li>\n \t<li style=\"text-align: left;\">Member of Anti Ragging Committee</li>\n \t<li style=\"text-align: left;\">Coordinated NAAC Criteria</li>\n</ul>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; color: white; mso-color-alt: windowtext; mso-ansi-language: EN-GB;\">Roles and Responsibilities: Department Level</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">Department Library In-charge</li>\n \t<li style=\"text-align: left;\">Newsletter Coordinator</li>\n \t<li style=\"text-align: left;\">NBA Criteria 1 Coordinator</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
