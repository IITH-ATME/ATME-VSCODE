  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table style=\"height: 301px;\" width=\"986\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-27976 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/03/Mr.-RANGASWAMY-S-1.jpg.jpeg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Mr. Rangaswamy S</strong></p>\n<p style=\"text-align: left;\"><strong>&nbsp;Designation: Assistant professor </strong></p>\n<p style=\"text-align: left;\"><strong>Program: Mathematics</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 2 years ,10 Months </strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching:&nbsp; </strong>5 Years</td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research: </strong>Nil</td>\n<td style=\"text-align: left;\" width=\"168\"><strong>Industry: </strong>Nil</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Email ID</strong></p>\n</td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Official:</strong> <a href=\"mailto:rangaswamys_maths@old.atme.edu.in\"><strong>rangaswamys_maths@old.atme.edu.in</strong></a>\n\n<strong>&nbsp;</strong></td>\n<td width=\"286\">\n<p style=\"text-align: left;\"><strong>Personal:</strong></p>\n<p style=\"text-align: left;\"><a href=\"mailto:rangaswamy0830@gmail.com\"><strong>rangaswamy0830@gmail.com</strong></a></p>\n<strong>&nbsp;</strong></td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Vidwan ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://vidwan.inflibnet.ac.in/error?id=0&amp;email=rangaswamy0830@gmail.com\">https://vidwan.inflibnet.ac.in/error?id=0&amp;email=rangaswamy0830@gmail.com</a></p>\n&nbsp;\n\n&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Google Scholar ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://scholar.google.com/citations?hl=en&amp;user=RhhExloAAAAJ\">https://scholar.google.com/citations?hl=en&amp;user=RhhExloAAAAJ</a></p>\n&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Scopus ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://www.scopus.com/freelookup/form/author.uri\">https://www.scopus.com/freelookup/form/author.uri</a></p>\n&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Orcid ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://orcid.org/0000-0002-7066-406X\">https://orcid.org/0000-0002-7066-406X</a></p>\n&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Web of Science Researcher ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>LinkedIn ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://www.linkedin.com/in/rangaswamy-s-2a4969263/\">https://www.linkedin.com/in/rangaswamy-s-2a4969263/</a></p>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>Ph.D </strong>in (Pursuing)</li>\n \t<li style=\"text-align: left;\"><strong>M.Sc</strong> in Mathematics</li>\n \t<li style=\"text-align: left;\"><strong style=\"font-family: inherit; font-size: inherit;\">B.Sc</strong><span style=\"font-family: inherit; font-size: inherit;\"> in (PMCS)</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">Complex&nbsp; Analysis,&nbsp; Differential Equations</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: justify;\"><b>NIL</b></p>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><strong><span style=\"color: #ffffff;\">Membership in Professional Bodies</span></strong></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: left;\">NIL</p>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Attended three days FDP on Essentials of Sciences for Engineering and Research -2025 in ATMECE from 15<sup>th</sup> Jan 2025 to 17<sup>th</sup> Jan 2025.</li>\n \t<li style=\"text-align: justify;\">Online certification and FDP on Finite difference approach &nbsp;from NPTEL Jan-April 2024.</li>\n \t<li style=\"text-align: justify;\">Attended five days FDP on Essentials of Sciences for Engineering and Research -2024 in ATMECE from 26<sup>th</sup> Feb 2024 to 1<sup>st</sup> March 2024.</li>\n \t<li style=\"text-align: justify;\">Attended One Week State Level FDP, a workshop on Cyber Security and Digital Forensics in association with Institute of Engineers (INDIA) from 21-25 August 2023 Organized by EEE, ATME College of Engineering.</li>\n \t<li style=\"text-align: justify;\">Attended 3 days FDP on the theme “Inculcating UHV in Technical Education “ by AICTE at ATME College of Engineering from 2<sup>nd</sup> to 4<sup>th</sup> of November 2023</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Proposal/Funding/Project Financial Assistance</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Honours/Awards/ Achievements</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Class teacher</li>\n \t<li>Mentor</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>",
