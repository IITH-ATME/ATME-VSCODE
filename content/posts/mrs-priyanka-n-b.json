  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table style=\"height: 301px;\" width=\"986\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-27960 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/03/Mrs.-PRIYANKA-N-B-1.jpg.jpeg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Priyanka N B</strong></p>\n<p style=\"text-align: left;\"><strong>Designation:</strong> Assistant Professor</p>\n<p style=\"text-align: left;\"><strong>Program:</strong> Mathematics</p>\n<p style=\"text-align: left;\"><strong>Professional Experience: </strong></p>\n\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching:17</strong></td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research: Nil</strong></td>\n<td width=\"168\">\n<p style=\"text-align: left;\"><strong>Industry: Nil</strong></p>\n</td>\n</tr>\n</tbody>\n</table>\n<p style=\"text-align: left;\">&nbsp;</p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Email ID</strong></p>\n</td>\n<td style=\"text-align: left;\" width=\"305\"><strong>Official: </strong><a href=\"mailto:priyankanb_maths@old.atme.edu.in\"><strong>priyankanb_maths@old.atme.edu.in</strong></a></td>\n<td width=\"267\">\n<p style=\"text-align: left;\"><strong>Personal: </strong><a href=\"mailto:priyabraj02@gmail.com\"><strong>priyabraj02@gmail.com</strong></a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Vidwan ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://vidwan.inflibnet.ac.in/profile/201872\">https://vidwan.inflibnet.ac.in/profile/201872</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Google Scholar ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://scholar.google.co.in/citations?user=%20hzKmQfMAAAAJ\">https://scholar.google.co.in/citations?user=%20hzKmQfMAAAAJ</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Scopus ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\">57740654300</p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Orcid ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"http://www.orcid.org/0000-0002-5305-4980\">http://www.orcid.org/0000-0002-5305-4980</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Web of Science Researcher ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>LinkedIn ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://www.linkedin.com/in/priyanka-n-b-b97a6181\">https://www.linkedin.com/in/priyanka-n-b-b97a6181</a></p>\n</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li><strong>Ph.D </strong>(Pursuing)</li>\n \t<li><strong>M.Sc</strong></li>\n \t<li><strong style=\"font-family: inherit; font-size: inherit;\">B.Sc</strong></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">Bio Fluid Mechanics</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Publication Details</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">“<strong>Peristaltic Flow and Heat Transfer through a Prandtl Fluid in Vertical Annulus</strong>” in &nbsp;recent Advances in Mechanical Engineering. Lecture Notes in Mechanical Engineering.Springer, Singapore.&nbsp;<a href=\"https://doi.org/10.1007/978-981-19-1388-4_16.\">https://doi.org/10.1007/978-981-19-1388-4_16</a>, 25<sup>th</sup>&nbsp;May 2022.&nbsp;</li>\n \t<li style=\"text-align: justify;\">“<strong>Effect of Heat Transfer on Peristaltic Transport of Prandtl Fluid in an Inclined &nbsp;Porous Channel</strong>” in&nbsp;Mathematics and Computing, Springer Proceedings in Mathematics &amp; &nbsp;Statistics 415,&nbsp;<a href=\"https://doi.org/10.1007/978-981-19-9307-7_45\">https://doi.org/10.1007/978-981-19-9307-7_45</a>,15 March 2023.</li>\n \t<li style=\"text-align: justify;\">“<strong style=\"text-align: justify; font-family: inherit; font-size: inherit;\">Peristaltic transport of Jeffrey Fluid in a Doubly Connected Region</strong><span style=\"text-align: justify; font-family: inherit; font-size: inherit;\">” in&nbsp; Journal of&nbsp; Propulsion Technology -Q3 journal ,ISSN: 1001-4055 ,Vol. 44 No. 5 (2023), 18</span><sup style=\"text-align: justify; font-family: inherit;\">th</sup><span style=\"text-align: justify; font-family: inherit; font-size: inherit;\"> Dec 2023, Page No: 3435 – 3446.</span></li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><strong><span style=\"color: #ffffff;\">Membership in Professional Bodies</span></strong></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: left;\">NIL</p>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Attended three days FDP on Essentials of Sciences for Engineering and Research -2025 in ATMECE from 15<sup>th</sup> Jan 2025 to 17<sup>th</sup> Jan 2025.</li>\n \t<li style=\"text-align: justify;\">Online certification and FDP on Numerical Analysis from NPTEL Jan-April 2024.</li>\n \t<li style=\"text-align: justify;\">Attended five days FDP on Essentials of Sciences for Engineering and Research -2024 in ATMECE from 26<sup>th</sup> Feb 2024 to 1<sup>st</sup> March 2024.</li>\n \t<li style=\"text-align: justify;\">Participated in 8<sup>th</sup> International Conference on Mathematics and Computing (ICMC-2022) from 6th to 8th January, 2022,VIT,Vellore-Online</li>\n \t<li style=\"text-align: justify;\">Participated in Third International Conference on 'Emerging Research in Civil, Aeronautical &amp; Mechanical Engineering' (ERCAM) from 16th and 17th December, 2021, Nitte Meenakshi Institute of Technology, Bengaluru, India.</li>\n \t<li style=\"text-align: justify;\">Online Course on “Orientation towards Technical Education &amp; Curriculum Aspects” NITTT2021</li>\n \t<li style=\"text-align: justify;\">Mathematical Concepts by Using Free open Source software-21 to 25-07-2020(5 days), BMSIT and Management-Online</li>\n \t<li style=\"text-align: justify;\">Attended three days FDP on “Importance of NAAC Accreditation in Higher Education Institutions” organised by ATME College of Engineering, Mysuru from 9 to 11-11-2020.</li>\n \t<li style=\"text-align: justify;\">Three Day National Level Online Faculty Development Program on \"AICTE Exam Reforms:An Overview\"-ATMECE from 27.08.2020 to 29.08.2020</li>\n \t<li style=\"text-align: justify;\">Annual Refresher Programme in Pedagogical Innovations And Research Methodology (Interdisciplinary) online mode at NPTEL-AICTE from Dec-Feb 2019</li>\n \t<li style=\"text-align: justify;\">Attended 3 days and 7 days “Faculty Development for Student Induction” from 24-26 June 2019 and 23-29 July 2019 in Belagavi and Sri Venkateshwara College of Engineering, Bangalore respectively.</li>\n \t<li style=\"text-align: justify;\">Attended 2 days and National Conference on Geometric Function Theory And its Applications, In Honour of Dr.S.Latha on 29-30 Jan 2018.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Proposal/Funding/Project Financial Assistance</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Honours/Awards/ Achievements</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Member Secretary of Women’s Cell</li>\n \t<li>Transportation Committee Member</li>\n \t<li>QS I- Gauge Member</li>\n \t<li>Academic Council Member</li>\n \t<li>Student Welfare Member</li>\n \t<li>Student Competition Coordinator</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li>Mentor</li>\n \t<li>Time Table Coordinator</li>\n \t<li>Course Coordinator</li>\n \t<li>Class Teacher</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>",
