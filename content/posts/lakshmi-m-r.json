  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-28238 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/04/Lakshmi-M-R-1.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name:</strong> <span style=\"color: #333399;\">Lakshmi M R</span>\n<strong>Designation:</strong> Assistant Professor\n<strong>Program:</strong> Master of Business Administration\n<strong>Professional Experience:</strong> 2 years</p>\n\n<table class=\" alignleft\">\n<tbody>\n<tr>\n<td style=\"text-align: center;\" width=\"158\"><strong>Teaching: 1.3years</strong></td>\n<td style=\"text-align: center;\" width=\"184\"><strong>Research: 1 year</strong></td>\n<td style=\"text-align: center;\" width=\"168\"><strong>Industry: 2 years</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><b>Email ID</b></td>\n<td style=\"text-align: left;\"><b>Official: <a href=\"mailto:lakshmi.mba@old.atme.edu.in\">lakshmi.mba@old.atme.edu.in</a></b></td>\n<td style=\"text-align: left;\"><b>Personal: <a href=\"mailto:lakshmirajesh74@gmail.com\">lakshmirajesh74@gmail.com</a></b></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\"><b>Vidwan ID</b></td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://vidwan.inflibnet.ac.in/profile/582961\"><span style=\"font-weight: 400;\">https://vidwan.inflibnet.ac.in/profile/582961</span></a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\"><b>Google Scholar ID</b></td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://scholar.google.com/citationsview_op=new_articles&amp;hl=en&amp;imq=Lakshmi+M+R#\"><span style=\"font-weight: 400;\">https://scholar.google.com/citations </span></a><a href=\"https://scholar.google.com/citationsview_op=new_articles&amp;hl=en&amp;imq=Lakshmi+M+R#\"><span style=\"font-weight: 400;\">view_op=new_articles&amp;hl=en&amp;imq=Lakshmi+M+R#</span></a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\"><b>Scopus ID</b></td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://click.notification.elsevier.com/CL0/https:%2F%2Fid.elsevier.com%2Fext%2FemailsignIn%3Fdgcid=raven_id_signin_one_time_link_IdentitySettings%26ui_locales=en-US%26continueTo=7o7QGPaBhbg%253D/2/010001934d4d34bd-660d30d7-066d-4cdb-8f8c-28774fcff9c7-000000/MxdewZjVkORIqkHgvsxgRgdSZcNE0zZD0pp0Lbfjsps=380\"><span style=\"font-weight: 400;\">scopusid</span></a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\"><b>Orcid ID</b></td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://orcid.org/0009-0003-9583-2669\"><span style=\"font-weight: 400;\">https://orcid.org/0009-0003-9583-2669</span></a></td>\n</tr>\n<tr>\n<td>\n<p style=\"text-align: left;\"><b>Web of Science Researcher ID</b><b></b></p>\n<p style=\"text-align: left;\">&nbsp;</p>\n</td>\n<td style=\"text-align: left;\" colspan=\"2\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\"><b>LinkedIn ID</b></td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://www.linkedin.com/in/lakshmi-m-r-4a306217a\"><span style=\"font-weight: 400;\">https://www.linkedin.com/in/lakshmi-m-r-4a306217a</span></a></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<h3 class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration-line: underline; color: #333399;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></strong></span></h3>\n<ul>\n \t<li class=\"li1\" style=\"text-align: left;\"><b>PhD (Pursing) </b></li>\n \t<li style=\"font-weight: 400; text-align: left;\" aria-level=\"1\"><b>Master of Business Administration</b></li>\n \t<li style=\"font-weight: 400; text-align: left;\" aria-level=\"1\"><b>Bachelor of Commerce</b></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ol class=\"ol1\">\n \t<li class=\"li1\" style=\"text-align: left;\">Human Resource Management</li>\n \t<li class=\"li2\" style=\"text-align: left;\">Human Resource Analytics</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Organizational Behaviour</li>\n \t<li class=\"li2\" style=\"text-align: left;\">Industrial Relations</li>\n \t<li class=\"li2\" style=\"text-align: left;\">Business Statistics</li>\n \t<li class=\"li3\" style=\"text-align: left;\">Managerial Economics</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>FDPs/Conferences/Workshops/STTP/MOOC Certification</strong></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"p1\" style=\"text-align: justify;\"><b>Conference </b></p>\n\n<ol class=\"ol1\" style=\"text-align: justify;\">\n \t<li class=\"li1\">Presented a Paper “AI-Empowered Boardrooms: Enhancing Corporate Governance Through Artificial Intelligence and Ethical Oversight” International Conference organized ISBR Business School. ISBN Number - 978-81-959613-7-5 held on 22<span class=\"s1\"><sup>nd</sup></span> &amp; 23<span class=\"s1\"><sup>rd</sup></span> August 2025.</li>\n \t<li class=\"li1\">Presented a Paper “Redefining HRM in Industry 5.0: Human-Centric Leadership for Sustainable Futures” National Conference Organized by GSSS College of Engineering. ISBN Number - 978-81-994274-6-4 held on 09-01-2026.</li>\n</ol>\n<p class=\"p1\" style=\"text-align: justify;\"><b>Online FDPs</b></p>\n\n<ol class=\"ol1\">\n \t<li class=\"li1\" style=\"text-align: justify;\">Participated in 12 Days National Level FDP on “HR Analytics – Basic to Advance”, organized by Swasthik Consulting Service, Bangalore, 3rd–14th February 2025.</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">Participated in 3 Days National Level FDP on Indian Knowledge System (IKS), organized by ATME College of Engineering, 5th–7th March 2025.</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">Participated in 5 Days Virtual Professional Development Programme on R for Statistical Analysis, organized by CMS Business School, 17th–21st March 2025.</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">Participated in One Week National Level FDP on Enhancing Inclusive Workspaces: Integrating Gender Sensitivity &amp; Cyber Hygiene in Academia, organized by ITM Gwalior, 17th–23rd June 2025.</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">Participated in 5 Days National Level FDP on ICT Tools &amp; Binary Accreditation for Modern Higher Education Institutions, organized by St. Joseph’s First Grade College, 23rd–27th June 2025.</li>\n \t<li class=\"li1\" style=\"text-align: justify;\">Participated in 5 Days FDP on STATA for Finance &amp; Economics Research, organized by Shri Guru School of Management Research &amp; Analytics, 6th–10th October 2025.</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><b style=\"font-family: inherit; font-size: inherit;\">Honours/Awards/</b><b style=\"font-family: inherit; font-size: inherit;\"> </b><b style=\"font-family: inherit; font-size: inherit;\">Achievements</b></span></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol class=\"ol1\">\n \t<li class=\"li1\" style=\"text-align: left;\">Certificate of Completion in Corporate HR, Industrial Relations &amp; Labour Laws, 16-02-2024 to 12-05-2024.</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Certificate of Completion – Ultimate HR Generalist (HRM), 6th February 2025.</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Certificate of Completion – Market ka Eklavya Course, 21st July 2025.</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Foundation Level – Innovation Ambassador Training (IIC), conducted by MoE’s Innovation Cell &amp; AICTE, 30th August 2025.</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Advanced Level – Innovation Ambassador Training (IIC), conducted by MoE’s Innovation Cell &amp; AICTE, 9th September 2025.</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Certificate of Completion – Intellectual Property Rights (IPR), 6th October 2025.</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Successfully completed the NPTEL Online Certification course on Organizational Behaviour.</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Author of the book “HR Analytics: Data-Driven Decision Making in Human</li>\n</ol>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\">\n<p class=\"p1\"><span style=\"color: #ffffff;\"><b>Roles and Responsibilities: Department Level</b></span></p>\n</td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol class=\"ol1\">\n \t<li class=\"li1\" style=\"text-align: left;\">AIMS Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: left;\">EMS Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Internal Assessment Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: left;\">VTU Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Scholarship Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: left;\">II Year 2025-26 MBA Class Coordinator</li>\n \t<li class=\"li1\" style=\"text-align: left;\">Research Coordinator</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
