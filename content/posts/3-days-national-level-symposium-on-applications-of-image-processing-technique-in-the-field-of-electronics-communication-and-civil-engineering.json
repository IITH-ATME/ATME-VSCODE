  "content": "<!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"medium\"} -->\n<p class=\"has-text-align-center has-medium-font-size\" style=\"text-align: center;\"><span style=\"color: #333399;\"><strong>3-Days National Level Symposium</strong></span></p>\n<span style=\"color: #333399;\"><strong><!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"medium\"} --></strong></span>\n<p class=\"has-text-align-center has-medium-font-size\" style=\"text-align: center;\"><span style=\"color: #333399;\"><strong>On</strong></span></p>\n<span style=\"color: #333399;\"><strong><!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"medium\"} --></strong></span>\n<p class=\"has-text-align-center has-medium-font-size\" style=\"text-align: center;\"><span style=\"color: #333399;\"><strong>“Applications of Image Processing Technique in the</strong></span><br /><span style=\"color: #333399;\"><strong>field of Electronics Communication and Civil Engineering\"</strong></span></p>\n<p style=\"text-align: center;\"><strong>Date: 06th to 08thNovember 2023</strong></p>\n<p style=\"text-align: center;\"><strong>Sponsored by</strong></p>\n<p style=\"text-align: center;\">Science and Engineering Research Board (SERB),<br />Department of Science &amp; Technology (DST), Govt. of India</p>\n<p style=\"text-align: center;\"><strong>Organized by</strong></p>\n<p style=\"text-align: center;\">Department of Civil Engineering</p>\n<p style=\"text-align: center;\">&amp;</p>\n<p style=\"text-align: center;\">Department of Electronics &amp; Communication Engineering</p>\n</div>\n<p style=\"text-align: left;\">Science and Engineering Research Board (SERB), Department of Science &amp; Technology (DST), Govt. of India had approved to conduct 3-Day National Level Symposium On “Applications of Image Processing Technique in the field of Electronics Communication and Civil Engineering” from 6 th to 8th November 2023 organized at ATME College of Engineering, Mysuru.</p>\n<p><span style=\"color: #0000ff;\"><a style=\"color: #0000ff;\" href=\"https://old.atme.edu.in/wp-content/uploads/2024/02/SERB-REPORT.pdf\">Download Report</a></span></p>\n<h4> </h4>\n<!-- /wp:html -->",
