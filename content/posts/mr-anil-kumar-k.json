  "content": "<!-- wp:paragraph -->\n<p style=\"text-align: justify;\"><strong>ANIL KUMAR K</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p style=\"text-align: justify;\"><strong>Education Details</strong></p>\n<ul style=\"text-align: justify;\">\n<li>M. Tech in Computer Integrated Manufacturing</li>\n<li>B. E in Mechanical Engineering</li>\n</ul>\n<p><strong>Contact Details</strong></p>\n<table width=\"663\">\n<tbody>\n<tr>\n<td width=\"124\"><span style=\"color: #000000;\"><strong>Email ID</strong></span></td>\n<td width=\"539\"><span style=\"color: #0000ff;\"><a style=\"color: #0000ff;\" href=\"mailto:anilkumark_me@old.atme.edu.in\">anilkumark_me@old.atme.edu.in</a></span></td>\n</tr>\n<tr>\n<td><span style=\"color: #000000;\"><strong>LinkedIn ID</strong></span></td>\n<td><span style=\"color: #0000ff;\"><a style=\"color: #0000ff;\" href=\"https://www.linkedin.com/in/anil-kumar-458753aa\">https://www.linkedin.com/in/anil-kumar-458753aa</a></span></td>\n</tr>\n<tr>\n<td><span style=\"color: #000000;\"><strong>Google Scholor  ID</strong></span></td>\n<td> </td>\n</tr>\n<tr>\n<td><span style=\"color: #000000;\"><strong>Orcid ID</strong></span></td>\n<td><span style=\"color: #0000ff;\"><a style=\"color: #0000ff;\" href=\"https://orcid.org/0000-0002-2709-0507\">https://orcid.org/0000-0002-2709-0507</a></span></td>\n</tr>\n<tr>\n<td><span style=\"color: #000000;\"><strong>Vidwaan ID</strong></span></td>\n<td><span style=\"color: #0000ff;\"><a style=\"color: #0000ff;\" href=\"https://vidwan.inflibnet.ac.in/profile/295808\">https://vidwan.inflibnet.ac.in/profile/295808</a></span></td>\n</tr>\n<tr>\n<td><span style=\"color: #000000;\"><strong>Scopus ID</strong></span></td>\n<td> </td>\n</tr>\n</tbody>\n</table>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p style=\"text-align: justify;\"><strong>Professional Experience</strong></p>\n<ul style=\"text-align: justify;\">\n<li>Teaching Experience: 03 Years</li>\n<li>Industrial Experience: 03 years</li>\n</ul>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p style=\"text-align: justify;\"><strong>Publication Details</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"ordered\":true} -->\n<ol style=\"text-align: justify;\">\n<li>Anil Kumar K, S.Prathik Jain, H.V.Ravindra, G.Ugrasen, , “Estimation of Surface Roughness and AE Signals while Machining of Titanium grade-2 Material in WEDM” Vol. 4, No. 2, May 2014, pp. 108-114.</li>\n</ol>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p style=\"text-align: justify;\"><strong>Roles and Responsibility</strong></p>\n<ul style=\"text-align: justify;\">\n<li>Placement Co-ordinator</li>\n<li>Sports &amp; cultural Co-ordinator</li>\n<li>Academic Co-ordinator</li>\n</ul>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p style=\"text-align: justify;\"><strong>Professional body membership</strong></p>\n<ul style=\"text-align: justify;\">\n<li>International Association of Engineers</li>\n</ul>\n<!-- /wp:paragraph -->",
