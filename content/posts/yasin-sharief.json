  "content": "<div style=\"border: 2px solid black; padding: 10px; box-sizing: border-box;\">\n<div style=\"border: 2px solid black; padding: 10px; font-family: Arial, sans-serif; font-size: 16px;\">\n\n<!-- Heading -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold;\">Technical Staff Profile</div>\n<!-- Faculty Profile: Two Columns -->\n<table style=\"width: 100%; border: 2px solid black; border-collapse: collapse; margin-top: 10px;\">\n<tbody>\n<tr><!-- Photo Placeholder -->\n<td style=\"border: 2px solid black; width: 30%; text-align: center; padding: 10px;\"><img class=\"aligncenter wp-image-28356 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2026/04/Yasin-Sharief-1-1.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<!-- Details -->\n<td style=\"border: 2px solid black; width: 70%; padding: 10px;\">\n<p style=\"text-align: left;\"><strong>Faculty Name: Yasin Sharief</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Foreman</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Electrical and Electronics Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: </strong></p>\n<p style=\"text-align: left;\"><strong>Date of Joining Institution:&nbsp;</strong><strong>07/08/2019</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td width=\"253\"><strong>Academic: 12 Years 7 Months</strong></td>\n<td width=\"257\"><strong>Industry: NA</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n<!-- Academic Details -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold; margin-top: 20px;\">Contact Details</div>\n<table width=\"100%\">\n<tbody>\n<tr>\n<td width=\"18%\"><strong>Email ID</strong></td>\n<td width=\"44%\"><strong>Official:</strong></td>\n<td width=\"37%\"><strong>Personal: </strong></td>\n</tr>\n<tr>\n<td width=\"18%\"><strong>&nbsp;</strong></td>\n<td width=\"44%\"><a href=\"mailto:YasinSharief_ee@atmemys.onmicrosoft.com\"><strong>YasinSharief_ee@atmemys.onmicrosoft.com</strong></a></td>\n<td width=\"37%\"><a href=\"mailto:Yasin.sharief1@gmail.com\"><strong>Yasin.sharief1@gmail.com</strong></a></td>\n</tr>\n</tbody>\n</table>\n</div>\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold; margin-top: 20px;\">Academic Details</div>\n<p style=\"text-align: left;\"><strong>Qualification</strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\">BE in Electrical and Electronics Engineering</li>\n \t<li style=\"text-align: left;\">Diploma in Electrical and Electronics Engineering</li>\n</ul>\n<!-- Certifications -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold;\">Workshops/STTP/MOOC Certification</div>\n<div style=\"padding: 15px;\">\n\n<strong>Online Courses</strong>\n<ul>\n \t<li>FDP-SJB Institute of Technology-4Days-‘A Skill Enhancement Workshop for Technical Staffs</li>\n \t<li>FDP- Vidyavardhaka College of Engineering -3 Days Professional Development Training For Technical Staff</li>\n \t<li>NPTL Course-Electrical Machines-II, A Basic Course on Electric and Magnetic Circuits</li>\n \t<li>Swayam-IGNOU-Electricity &amp; Safety Measures</li>\n \t<li>Virtual Labs-1 Day Session in ATME college of Engineering</li>\n \t<li>Udemy-Basic Electrical and Electronics Engineering, PLC Programming From Scratch, AutoCAD Electrical from beginner to expert</li>\n \t<li>Tata Steel-a)Induction Motor b) Transformer</li>\n \t<li>Coursera-Introduction to Microsoft Excel</li>\n \t<li>LinkedIn-Microsoft Team Essential Training-2Hr-21Min</li>\n \t<li>Learning PowerPoint for the Web (Office365/Microsoft 365)-1Hr-29Min</li>\n</ul>\n</div>\n<!-- Roles and Responsibilities: Institute Level -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold;\">Roles and Responsibilities: Institute Level</div>\n<div style=\"padding: 15px;\">DG Maintenance, Water Facility Maintenance</div>\n<!-- Roles and Responsibilities: Department Level -->\n<div style=\"background-color: #001f4d; color: white; padding: 10px; text-align: center; font-weight: bold;\">Roles and Responsibilities: Department Level</div>\n<div style=\"padding: 15px;\">Stock Inventory, Laboratories Maintenance, Supervising the Non-teaching Staff Regarding Work, Lab Supervisor, Lab Instructor for Electrical Machines Lab, Power Electronics Lab, Analog Electronics Lab, High Voltage Lab and Basic Electrical Lab</div>\n</div>",
