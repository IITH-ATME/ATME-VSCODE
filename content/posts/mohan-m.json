  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table style=\"height: 250px;\" width=\"878\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-22750 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/11/Mr.-Mohan-M-2.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Mohan M </strong></p>\n<p style=\"text-align: left;\"><strong>Designation:</strong> &nbsp;<strong>Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program:</strong> <strong>Electrical &amp; Electronics Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 11</strong></p>\n\n<table style=\"height: 50px;\" width=\"535\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"158\"><strong>Teaching: 11</strong></td>\n<td style=\"text-align: left;\" width=\"184\"><strong>Research: NA</strong></td>\n<td width=\"168\">\n<p style=\"text-align: left;\"><strong>Industry: NA</strong></p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Email ID</strong></p>\n</td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Official: <a href=\"mailto:mohan.m@old.atme.edu.in\">mohan.m@old.atme.edu.in</a></strong></td>\n<td width=\"286\">\n<p style=\"text-align: left;\"><strong>Personal: <a href=\"mailto:mohangowda88@gmail.com\">mohangowda88@gmail.com</a></strong></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Vidwan ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://vidwan.inflibnet.ac.in/profile/265777\">https://vidwan.inflibnet.ac.in/profile/265777</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Google Scholar ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://scholar.google.com/citations?user=exldMDAAAAAJ&amp;hl=en\">https://scholar.google.com/citations?user=exldMDAAAAAJ&amp;hl=en</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Scopus ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Orcid ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">\n<p style=\"text-align: left;\"><a href=\"https://orcid.org/0000-0001-7327-4369\">https://orcid.org/0000-0001-7327-4369</a></p>\n</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>Web of Science Researcher ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">&nbsp;</td>\n</tr>\n<tr>\n<td width=\"147\">\n<p style=\"text-align: left;\"><strong>LinkedIn ID</strong></p>\n</td>\n<td colspan=\"2\" width=\"572\">&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<p style=\"text-align: left;\"><strong><span style=\"text-decoration: underline; color: #333399;\">Qualification</span></strong></p>\n\n<ul>\n \t<li style=\"text-align: left;\"><strong>M.Tech</strong> in Maintenance Engineering</li>\n \t<li style=\"text-align: left;\"><strong style=\"font-family: inherit; font-size: inherit;\">B.E</strong><span style=\"font-family: inherit; font-size: inherit;\"> in Electrical and Electronics Engineering</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: justify;\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">Energey Auditing</li>\n \t<li style=\"text-align: left;\">Electrical Machines</li>\n \t<li style=\"text-align: left;\">Cybersecurity</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Membership in Professional Bodies</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">MISTE- Member of Indian Society for Technical Education</li>\n \t<li style=\"text-align: left;\">AMIE – Associate Member of the the Institute of Engineers</li>\n \t<li style=\"text-align: left;\">IAENG- International Association of Engineering</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Honours/Awards/ Achievements</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: justify;\">Successfully completed 100kVa Grid Tied Solar project in ATME College Campus in September 2016</li>\n \t<li style=\"text-align: justify;\">Successfully Completed 350-seater, Centralized, State of art auditorium in the college campus in 2015</li>\n \t<li style=\"text-align: justify;\">Successfully completed 35 kVa OFF Grid Solar project in ATME College Campus in September 2021.CII – Certified professional in Building Energy Management – Certificate No: BEMSIII/092020/119.</li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li>Certification courses on Building energy management – Online CII</li>\n \t<li>Symposium – E Vehicle and its charging Technology – KPTCL</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Institute Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li>In charge of College Infrastructure Maintenance</li>\n \t<li>In charge of Enterprise resource planning</li>\n \t<li>In charge of procuring and finalizing the material purchase</li>\n \t<li>In charge of College IT infrastructure</li>\n \t<li>In charge of College Power source infrastructure</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>",
