  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-25814 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2024/11/Tanya-R-1-1.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: <span style=\"color: #333399;\">Tanya R</span></strong>\n<strong>Designation: Assistant Professor</strong>\n<strong>Program: Master of Computer Applications</strong>\n<strong>Professional Experience: 9 months </strong></p>\n\n<table class=\" alignleft\">\n<tbody>\n<tr>\n<td style=\"text-align: center;\" width=\"158\">Teaching: 9 months</td>\n<td style=\"text-align: center;\" width=\"184\">Research: 0</td>\n<td style=\"text-align: center;\" width=\"168\">Industry: 0</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"147\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Official: </strong><a href=\"mailto:tanyar.mca@old.atme.edu.in\">tanyar.mca@old.atme.edu.in</a></td>\n<td style=\"text-align: left;\" width=\"286\"><strong>Personal: </strong><a href=\"mailto:tanyarajesh03@gmail.com\">tanyarajesh03@gmail.com</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\">Vidwan ID</td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"573\"><a href=\"https://vidwan.inflibnet.ac.in/profile/582630\">https://vidwan.inflibnet.ac.in/profile/582630</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\">Google Scholar ID</td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"573\"><a href=\"https://scholar.google.com/citations?view_op=new_articles&amp;hl=en&amp;imq=Tanya+R#\">https://scholar.google.com/citations?view_op=new_articles&amp;hl=en&amp;imq=Tanya+R#</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\">Scopus ID</td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"573\"><a href=\"https://id.elsevier.com/settings/redirect?code=55sPD3QFaN_TU-zDHUDvJCJq8ykOaG9RiX5ndf8L\">https://id.elsevier.com/settings/redirect?code=55sPD3QFaN_TU-zDHUDvJCJq8ykOaG9RiX5ndf8L</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\">Orcid ID</td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"573\"><a href=\"https://orcid.org/0009-0004-6209-5102\">https://orcid.org/0009-0004-6209-5102</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\">Web of Science Researcher ID</td>\n<td colspan=\"2\" width=\"573\">&nbsp;</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"147\">LinkedIn ID</td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"573\"><a href=\"http://www.linkedin.com/in/tanya-r-\">http://www.linkedin.com/in/tanya-r-</a></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<h4 class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration-line: underline; color: #333399;\"><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></span></h4>\n<p style=\"text-align: left;\">• MCA\n• BCA</p>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 52.7pt; text-align: left;\" width=\"100%\">• Image Processing\n• IoT\n• Cyber Security</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">FDPs/Conferences/Workshops/STTP/MOOC Certification</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p style=\"text-align: justify;\"><strong>FDP</strong></p>\n\n<ol>\n \t<li style=\"text-align: justify;\">FDP on Indian Knowledge System organized by ATMECE in collaboration with vidyabharathi uchcha shiksha sansthan (5<sup>th</sup> march 2025 – 7<sup>th</sup> march 2025)</li>\n \t<li style=\"text-align: justify;\">6-day Faculty Development Program on Cybersecurity organized in MYRA school of Business in collaboration with CySecK, Cyberverse Foundation&nbsp; and IISc (21<sup style=\"font-family: inherit;\">st</sup><span style=\"font-family: inherit; font-size: inherit;\"> july 2025 – 26</span><sup style=\"font-family: inherit;\">th</sup><span style=\"font-family: inherit; font-size: inherit;\"> july 2025)</span></li>\n</ol>\n</td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><strong><span style=\"color: #ffffff;\">Roles and Responsibilities: Department Level</span></strong></td>\n</tr>\n<tr style=\"height: 22.45pt; text-align: justify;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">IA coordinator</li>\n \t<li style=\"text-align: left;\">Magazine coordinator</li>\n \t<li style=\"text-align: left;\">Department club coordinator</li>\n \t<li style=\"text-align: left;\">Women cell member</li>\n</ol>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
