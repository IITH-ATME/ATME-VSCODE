  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><a href=\"https://old.atme.edu.in/prashant-r-kaigaddi/prashant-r-kaigaddi-2/\" rel=\"attachment wp-att-20449\"><img class=\"aligncenter wp-image-21249 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2024/11/Prashant-R-Kaigaddi.jpg\" alt=\"\" width=\"150\" height=\"200\"></a></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: <span style=\"color: #333399;\">Prashant R Kaigaddi</span></strong>\n<strong>Designation: </strong>Assistant Professor\n<strong>Program: </strong>Master of Computer Application\n<strong>Professional Experience: </strong>01</p>\n\n<table class=\" alignleft\">\n<tbody>\n<tr>\n<td style=\"text-align: center;\" width=\"158\"><strong>Teaching: 1 Year</strong></td>\n<td style=\"text-align: center;\" width=\"184\"><strong>Research: 0</strong></td>\n<td style=\"text-align: center;\" width=\"168\"><strong>Industry: 1 year</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table class=\"table-responsive align\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><b>Email ID</b></td>\n<td style=\"text-align: left;\"><b>Official:<a href=\"mailto:prashantrkaigaddi.mca@old.atme.edu.in\">prashantrkaigaddi.mca@old.atme.edu.in</a>&nbsp;</b></td>\n<td style=\"text-align: left;\"><b>Personal: <a href=\"mailto:prashantkaigaddi@gmail.com\">prashantkaigaddi@gmail.com</a></b></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\"><b>Vidwan ID</b></td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://vidwan.inflibnet.ac.in/profile/562886\"><span style=\"font-weight: 400;\">https://vidwan.inflibnet.ac.in/profile/562886</span></a><span style=\"font-weight: 400;\">&nbsp;</span></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\"><b>Google Scholar ID</b></td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://scholar.google.com/citations?view_op=new_articles&amp;hl=en&amp;imq=Prashant+kaigaddi#\"><span style=\"font-weight: 400;\">https://scholar.google.com/citations?view_op=new_articles&amp;hl=en&amp;imq=Prashant+kaigaddi#</span></a><span style=\"font-weight: 400;\">&nbsp;</span></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\"><b>Scopus ID</b></td>\n<td style=\"text-align: left;\" colspan=\"2\"><a href=\"https://id.elsevier.com/settings/redirect?code=MrcEVHBN8LXK27cApRQeLUG5CuhhiSz1KEUY4Ref#\"><span style=\"font-weight: 400;\