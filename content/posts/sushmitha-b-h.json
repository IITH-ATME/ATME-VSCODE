  "content": "&nbsp;\n<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table>\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-25799 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2025/11/SUSHMITHA-B-H-1.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: SUSHMITHA B H </strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor </strong></p>\n<p style=\"text-align: left;\"><strong>Program: </strong><strong>Master of Computer Applications</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience: 2</strong></p>\n\n<table>\n<tbody>\n<tr>\n<td width=\"158\"><strong>Teaching:&nbsp; Nil</strong></td>\n<td width=\"184\"><strong>Research: Nil</strong></td>\n<td width=\"168\"><strong>Industry: 2 years</strong></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size