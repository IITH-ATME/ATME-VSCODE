  "content": "<table class=\"MsoNormalTable\" style=\"width: 100%; border-collapse: collapse; border: none;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Faculty Profile</span></span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<table class=\"center\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\"><img class=\"aligncenter wp-image-25202 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2025/09/Mr.-Rajeev-Gowda-R-2.jpg\" alt=\"\" width=\"150\" height=\"200\"></td>\n<td>\n<p style=\"text-align: left;\"><strong>Faculty Name: Mr. Rajeev Gowda R</strong></p>\n<p style=\"text-align: left;\"><strong>Designation: Assistant Professor</strong></p>\n<p style=\"text-align: left;\"><strong>Program: Electronics &amp; Communication Engineering</strong></p>\n<p style=\"text-align: left;\"><strong>Professional Experience:</strong></p>\n\n<table class=\" alignleft\" style=\"height: 79px;\" width=\"576\">\n<tbody>\n<tr>\n<td width=\"158\"><strong>Teaching: 4.5 Years</strong></td>\n<td width=\"184\"><strong>Research: Nil</strong></td>\n<td width=\"168\"><strong>Industry: 6 months</strong></td>\n</tr>\n</tbody>\n</table>\n<p style=\"text-align: left;\">&nbsp;</p>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif; color: white;\">Contact Details</span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" width=\"100%\">\n<table width=\"100%\">\n<tbody>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Email ID</strong></td>\n<td style=\"text-align: left;\" width=\"36%\"><strong>Official: <a href=\"mailto:rajeevgowdar.ec@old.atme.edu.in\">rajeevgowdar.ec@old.atme.edu.in</a></strong></td>\n<td style=\"text-align: left;\" width=\"38%\"><strong>Personal:</strong> <a href=\"mailto:rajeevgowda94@gmail.com\"><strong>rajeevgowda94@gmail.com</strong></a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Vidwan ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\"><a href=\"https://vidwan.inflibnet.ac.in//profile/549370\">https://vidwan.inflibnet.ac.in//profile/549370</a></td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Google Scholar ID-</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\">GbxhY08AAAAJ</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Scopus ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\">-</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Orcid ID-</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\">0009-0006-7772-1246</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>Web of Science Researcher ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\">-</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\" width=\"25%\"><strong>LinkedIn ID</strong></td>\n<td style=\"text-align: left;\" colspan=\"2\" width=\"74%\"><a href=\"http://www.linkedin.com/in/rajeev-gowda-r-a66341114\"><b>www.linkedin.com/in/rajeev-gowda-r-a66341114</b></a></td>\n</tr>\n</tbody>\n</table>\n<table class=\"MsoNormalTable\" style=\"width: 100.0%; border-collapse: collapse; border: none; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 5.4pt 0cm 5.4pt; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black;\" border=\"1\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"font-size: 18px;\"><span style=\"color: #ffffff;\"><span lang=\"EN-GB\" style=\"font-family: 'Times New Roman', serif;\">Academic Details</span></span></span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<h3 class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: left;\"><span style=\"text-decoration-line: underline; color: #333399;\"><strong><span lang=\"EN-GB\" style=\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-ansi-language: EN-GB;\">Qualification</span></strong></span></h3>\n<ul>\n \t<li style=\"text-align: left;\"><strong>M.Tech</strong> in Digital Electronics and Communication System</li>\n \t<li style=\"text-align: left;\"><strong style=\"font-family: inherit; font-size: inherit;\">B.E</strong><span style=\"font-family: inherit; font-size: inherit;\"> in Electronics and Communication</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; mso-border-alt: solid black .5pt; background: #002060; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; text-align: center;\"><strong><span style=\"color: #ffffff;\">Areas of Interest</span></strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 52.7pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 52.7pt;\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: left;\">Image Processing</li>\n \t<li style=\"text-align: left;\">IoT</li>\n \t<li style=\"text-align: left;\">Network Security</li>\n</ol>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 2; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Publication Details</strong></span></td>\n</tr>\n<tr style=\"mso-yfti-irow: 3; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">\"A Review on Medical Image Classification Approaches\", International Journal of Emerging Technologies and Innovative Research (www.jetir.org), ISSN:2349-5162, Vol.5, Issue 6, page no.885-889, June-2018. 2.\"Recovery Analysis of Skin Transplantation Using SVM\", International Journal of Emerging Technologies and Innovative Research (www.jetir.org), ISSN:2349-5162, Vol.5, Issue 6, page no.259-265, June-2018.</li>\n \t<li style=\"text-align: justify;\">\"Recovery Analysis of Skin Transplantation Using SVM\", International Journal of Emerging Technologies and Innovative Research (www.jetir.org), ISSN:2349-5162, Vol.5, Issue 6, page no.259-265, June-2018.</li>\n</ol>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 4; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Membership in Professional Bodies</strong></span></td>\n</tr>\n<tr style=\"mso-yfti-irow: 5; mso-yfti-lastrow: yes; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">&nbsp;NIL</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Honours/Awards/</strong><strong> Achievements</strong></span></td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; padding: 0cm 5.4pt; height: 22.45pt; text-align: left;\" valign=\"top\" width=\"100%\">NIL</td>\n</tr>\n</tbody>\n<tbody>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>FDPs/Conferences/Workshops/STTP/MOOC Certification</strong></span></td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ol>\n \t<li style=\"text-align: justify;\">Participated in Latex training and hands-on workshop at ATME,Mysuru.</li>\n \t<li style=\"text-align: justify;\">Participated in VGST-FDP on Real Time Multi Core Design Engineering in the Field of Communication at VVIET,Mysuru.</li>\n \t<li style=\"text-align: justify;\">Participated in EETP course conducted by BSNL at RTTC,Mysuru.</li>\n \t<li style=\"text-align: justify;\">Participated in the W@W Empower Session workshop organised by Karnataka Digital Economy Mission (KDEM) on 25<sup>th</sup> July 2023 at SJCE Campus Mysuru.</li>\n \t<li style=\"text-align: justify;\">Attended the workshop Orientation regarding NSDC programmes by Aspire Knowledge and Skill India Pvt.Ltd at BMS College of Engineering on 4<sup>th</sup> March 2024.</li>\n \t<li style=\"text-align: justify;\">Participated in FDP on “Computer Networks and Internet of Things” held during 03-03-2025 to 07-03-2025 organized by JSS Polytechnic for the Differently Abled, Mysuru, Karnataka.</li>\n \t<li style=\"text-align: justify;\">Participated in Five day FDP on “Cyber Security Awareness and Emerging Technologies for Secure Media And Banking Applications” in association with ATME IEEE STB35744 from 10<sup>th</sup> to 14<sup>th</sup> MArch 2025 organized by the Department of ECE at ATME College of Engineering , Mysuru.</li>\n \t<li style=\"text-align: justify;\">Participated in Three-day Comprehensive Workshop on “Patent Drafting, Filing and Interpretation” from 12<sup>th </sup>to 14<sup>th</sup> June 2025 organized by IPR-Cell in association with IIC, ATME College of Engineering , Mysuru.</li>\n</ol>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 11; height: 22.45pt;\">\n<td style=\"width: 100%; border-right: 1pt solid black; border-bottom: 1pt solid black; border-left: 1pt solid black; border-image: initial; border-top: none; background: #002060; padding: 0cm 5.4pt; height: 22.45pt; text-align: center;\" valign=\"top\" width=\"100%\"><span style=\"color: #ffffff;\"><strong>Roles and Responsibilities: Department Level</strong></span></td>\n</tr>\n<tr style=\"mso-yfti-irow: 12; height: 22.45pt;\">\n<td style=\"width: 100.0%; border: solid black 1.0pt; border-top: none; mso-border-top-alt: solid black .5pt; mso-border-alt: solid black .5pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.45pt;\" valign=\"top\" width=\"100%\">\n<ul>\n \t<li style=\"text-align: left;\">K-Tech NAIN Coordinator</li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>",
