  "content": "<div class=\"entry-header\">\n<h2 class=\"entry-title event-entry-title course-entry-title\" style=\"text-align: center;\">“Standardization in Industry”</h2>\n</div>\n<div class=\"entry-blog single-course-content\">\n<div class=\"entry-summary clearfix\">\n<div class=\"container\">\n<div class=\"vc_row wpb_row vc_row-fluid\">\n<div class=\"wpb_column vc_column_container vc_col-sm-12\">\n<div class=\"vc_column-inner \">\n<div class=\"wpb_wrapper\">\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n\n&nbsp;\n\n&nbsp;\n<p style=\"text-align: center;\"><strong>Webinar on</strong><strong>– “Standardization in Industry” in Association with Institution’s Innovation Council (IIC) – ATMECE</strong></p>\n<p style=\"text-align: center;\"><strong>Date : </strong>6<sup>th</sup>  Jan</p>\n<p style=\"text-align: center;\"><strong>Time :</strong>3.00 PM</p>\n<p style=\"text-align: center;\"><strong>Platform: </strong>MS Teams</p>\n&nbsp;\n\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<img class=\"size-full wp-image-4535 aligncenter\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/05/bosch.png\" alt=\"\" width=\"132\" height=\"168\" />\n<div class=\"entry-blog single-course-content\">\n<div class=\"entry-summary clearfix\">\n<div class=\"container\">\n<div class=\"vc_row wpb_row vc_row-fluid\">\n<div class=\"wpb_column vc_column_container vc_col-sm-12\">\n<div class=\"vc_column-inner \">\n<div class=\"wpb_wrapper\">\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n<p style=\"text-align: center;\"><strong>Resource Person :  N. Srinivasa Murthy</strong></p>\n<p style=\"text-align: center;\"><strong>Senior Manager (Rtd.)</strong></p>\n<p style=\"text-align: center;\"><strong>Bosch, Bangalore</strong></p>\n<p style=\"text-align: center;\"><strong>IIC President</strong></p>\n<p style=\"text-align: center;\"><strong>Dr. Rathnakar G</strong></p>\n<p style=\"text-align: center;\"><strong>Convener</strong></p>\n<p style=\"text-align: center;\"><strong>Dr. Srinivasa K</strong></p>\n<p style=\"text-align: center;\">Prof. &amp; Head</p>\n<p style=\"text-align: center;\">Dept. Mechanical Engg.</p>\n<p style=\"text-align: center;\">ATMECE, Mysuru</p>\n<p style=\"text-align: center;\"><strong>Co-o</strong><b>rdinators</b></p>\n<p style=\"text-align: center;\"><strong>Prof. Devaraj M R,</strong></p>\n<p style=\"text-align: center;\">Asso. Prof., Dept. Mechanaical Engineering</p>\n<p style=\"text-align: center;\"><strong>Dr.Mohanakumara K C,</strong></p>\n<p style=\"text-align: center;\">Asst. Prof., Dept. Mechanical Engineering</p>\n<p style=\"text-align: center;\"><strong>Prof.Niranjan Kumar V S</strong>,</p>\n<p style=\"text-align: center;\">Asst. Prof., Dept. Mechanical Engineering</p>\n<p style=\"text-align: center;\"><strong>Prof.Yashwanth N, </strong></p>\n<p style=\"text-align: center;\">Asst. Prof., Dept. Mechanical Engineering</p>\n<p style=\"text-align: center;\">Registration Link: <a href=\"https://forms.gle/3Zom2LXknxfFjGdE6\">Click</a></p>\n<p style=\"text-align: center;\">E-Certificates will be issued to those participants who will attend the entire session and fill the feedback form.</p>\n<p style=\"text-align: center;\"><strong>For information please Contact:</strong></p>\n<p style=\"text-align: center;\">Prof. Devaraj M R:       9972322811</p>\n<p style=\"text-align: center;\">Prof: Yashwanth N:     9663994514</p>\n\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>",
