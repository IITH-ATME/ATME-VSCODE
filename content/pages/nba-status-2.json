  "content": "[vc_row][vc_column][vc_column_text]\n<div class=\"addon-themeum-title \">\n<div class=\"themeum-title title-normal normal\">\n<h2 class=\"thm-titlecustomstyle\">NBA Approval</h2>\n</div>\n</div>\n<div class=\"wpb_text_column wpb_content_element \">\n<div class=\"wpb_wrapper\">\n\n&nbsp;\n\nWe are Pleased to Inform that the Following Programs are  NBA Accredited For the Academic Year 2019-20 to 2021-22 i.e. upto 30-06-2022\n\n<strong>Electronics &amp; Communication, Civil Engineering, Electrical &amp; Electronics, Mechanical Engineering</strong>\n\n&nbsp;\n\nNBA Approval\n\n<img class=\"aligncenter wp-image-2875 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/05/NBA-1.jpg\" alt=\"\" width=\"800\" height=\"1132\" />\n\n<img class=\"aligncenter wp-image-2874 size-full\" src=\"https://old.atme.edu.in/wp-content/uploads/2022/05/NBA-2.jpg\" alt=\"\" width=\"800\" height=\"1132\" />\n\n</div>\n</div>\n[/vc_column_text][/vc_column][/vc_row]"
